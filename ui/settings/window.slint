// ui.md §6.3 设置窗口骨架。旧版 TiLex/src/window/Config/index.jsx。
import { AboutPage } from "about.slint";
import { ServicesPage, ServiceRow } from "services.slint";
import { ServiceDialogs, ServiceDraft, AiPreset, ModelRow } from "service_dialogs.slint";
export { ServiceDraft, AiPreset, ModelRow } from "service_dialogs.slint";
import { TranslatePage } from "translate.slint";
import { WordbookPage, WordbookState, WordbookRow } from "wordbook.slint";
export { WordbookState, WordbookRow } from "wordbook.slint";
import { Card } from "../common/card.slint";
import { IconButton } from "../common/icon_button.slint";
import { PillTabs } from "../common/pill_tabs.slint";
import { Theme } from "../common/theme.slint";
import { Toast } from "../common/toast.slint";
import { Modal } from "../common/modal.slint";
import { Button } from "../common/button.slint";
import { ScrollArea } from "../common/scroll_area.slint";
import { Palette } from "std-widgets.slint";

component LanguageButton {
    in property <string> language: "zh_CN";
    in property <bool> enabled: true;
    callback clicked();

    property <bool> kb-focus: false;

    forward-focus: fs;
    width: 26px;
    height: 26px;
    accessible-role: AccessibleRole.button;
    accessible-label: @tr("Interface language");

    // 键盘 Tab 焦点环（比控件大 2px，圆角 +2）
    if root.kb-focus : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 15px;
        border-width: 2px;
        border-color: Theme.focus;
    }

    bg := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 13px;

        background: touch.pressed
            ? Theme.default-200
            : (touch.has-hover ? Theme.default-base.with-alpha(0.4) : Colors.transparent);

        opacity: root.enabled ? 1.0 : 0.5;

        // 底色不做过渡，理由见 icon_button.slint
        animate opacity { duration: 150ms; }

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: root.language == "zh_CN" ? "中" : "EN";
            font-size: 12px;
            font-weight: 700;
            color: Theme.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    fs := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        focus-gained(reason) => {
            root.kb-focus = reason == FocusReason.tab-navigation;
        }
        focus-lost(reason) => {
            root.kb-focus = false;
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }

        touch := TouchArea {
            width: 100%;
            height: 100%;
            enabled: root.enabled;
            mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                root.clicked();
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: @tr("TiLex Settings");
    icon: @image-url("../icons/app.png");
    no-frame: true;
    resize-border-width: 5px;
    min-width: 800px;
    min-height: 600px;
    preferred-width: 800px;
    preferred-height: 600px;
    background: Theme.background;
    // 旧版整套界面的中文落在「微软雅黑 Light」上（量过截图的墨量），Slint 默认 400 会挑 Regular，看着粗一圈。
    // 显式写了 font-weight 的地方（标题 700、正文强调 600）不受影响。
    default-font-weight: Theme.font-weight;
    default-font-family: Theme.font-family;

    in-out property <ColorScheme> color-scheme <=> Palette.color-scheme;
    in property <string> theme-mode: "system";
    in property <string> language: "zh_CN";
    in-out property <int> page: 0;

    in property <string> version: "";
    in-out property <bool> autostart-enabled: false;
    in property <bool> autostart-supported: true;
    in property <bool> checking-update: false;
    in property <string> credits-raw: @tr("Based on [pot-desktop](https://github.com/pot-app/pot-desktop) · UI/UX inspired by [Easydict](https://github.com/tisfeng/Easydict) · Tool logic drawn from [STranslate](https://github.com/STranslate/STranslate) · [GPL-3.0](https://github.com/BearKouber/TiLex/blob/HEAD/LICENSE) License");
    in property <styled-text> credits;

    property <bool> has-dragged: false;

    // 无边框窗口从任务栏还原后位置会掉到屏幕左上角（B2 F7 手测），Rust 侧重新居中。
    changed minimized => {
        // 最大化状态还原回来的不用管：它本来就铺满屏幕，再挪位置反而错位
        if !root.minimized && !root.maximized {
            root.restored();
        }
    }

    callback restored();
    callback drag();
    callback cycle-theme();
    callback toggle-language();
    callback close-clicked();

    callback open-url(string);
    callback open-github();
    callback open-feedback();
    callback open-releases();
    callback autostart-toggled(bool);
    callback check-update();
    callback view-log();
    callback view-config();

    // Services Page
    in-out property <[ServiceRow]> translate-services: [];
    in-out property <[ServiceRow]> recognize-services: [];

    callback set-service-enabled(string, int, bool);
    callback remove-service(string, int);
    callback move-service(string, int, int);
    callback edit-service(string, int);

    // Service Dialog Chain
    in-out property <int> dialog: 0;
    in-out property <string> dialog-kind: "translate";
    in-out property <string> dialog-service: "google";
    in-out property <int> dialog-index: -1;
    in-out property <bool> testing-service: false;
    in-out property <bool> fetching-models: false;
    in property <[ModelRow]> ai-models: [];
    in property <[string]> ai-model-names: [];
    in-out property <int> ai-model-index: -1;
    in property <bool> bench-running: false;
    in property <string> bench-current: "";
    in property <int> bench-remaining: 0;
    in property <int> bench-tested: 0;
    in property <int> bench-failed: 0;

    in-out property <string> draft-label: "";
    in-out property <int> draft-google-mode-index: 0;
    in-out property <string> draft-google-custom-url: "";
    in-out property <string> draft-google-api-key: "";
    in-out property <string> draft-google-custom-api-url: "";

    // AI Draft Properties
    in-out property <string> draft-ai-base-url: "";
    in-out property <string> draft-ai-api-key: "";
    in-out property <string> draft-ai-model: "";
    in-out property <int> draft-ai-protocol-index: 0;
    in-out property <string> draft-ai-custom-instructions: "";
    in-out property <string> draft-ai-icon: "";
    in-out property <bool> draft-ai-has-logo: false;
    in-out property <brush> draft-ai-icon-color: Theme.foreground;
    in-out property <string> draft-ai-icon-letter: "";

    // Bing Draft Properties
    in-out property <int> draft-bing-mode-index: 0;
    in-out property <string> draft-bing-auth-key: "";
    in-out property <string> draft-bing-region: "";
    in-out property <string> draft-bing-custom-url: "";

    // DeepL Draft Properties
    in-out property <int> draft-deepl-mode-index: 0;
    in-out property <string> draft-deepl-auth-key: "";
    in-out property <string> draft-deepl-custom-url: "";

    // Baidu Draft Properties
    in-out property <string> draft-baidu-appid: "";
    in-out property <string> draft-baidu-secret: "";

    // Umi-OCR Draft Properties
    in-out property <string> draft-umi-url: "";

    in-out property <string> resolved-chat-url: "";
    in property <[AiPreset]> ai-presets: [];
    in property <string> default-ai-custom-instructions: @tr("Accurately, naturally, and concisely convey the original meaning in the selected target language. Use context to understand polysemous words, and prioritize standard terminology for specialized content. For words and phrases, highlight common definitions and collocations; for sentences, preserve the original meaning and tone, and break down complex sentences into core structures, modifiers, and key terms. Provide brief examples or explanations when necessary, and avoid irrelevant elaborations.");

    in property <brush> wechat-icon-color;
    in property <brush> umi-icon-color;
    // 识别服务每种只装一个：装过的不再出现在「添加内置服务」里
    in property <bool> recognize-has-wechat: false;
    in property <bool> recognize-has-umi: false;

    callback save-service(ServiceDraft);
    callback test-service(ServiceDraft);
    callback fetch-models(ServiceDraft);
    callback refresh-resolved-url(string, string, string, string);
    callback start-benchmark(ServiceDraft, bool);
    callback stop-benchmark(ServiceDraft);

    public function show-bench-error(err: string) {
        dialogs.show-test-result(@tr("Cannot start speed test: {}", err), false);
    }

    // 测试结果不走 Toast：Toast 钉在窗口正中，会压住对话框里的控件，关掉对话框还浮在那。
    // 旧版是在表单里加一行结果条（`google/Config.jsx:194-204`），跟着对话框走。
    public function show-test-success(text: string, ms: int) {
        dialogs.show-test-result(@tr("Connection OK: \"Hello world\" → \"{}\" ({}ms)", text, ms), true);
    }

    public function show-test-failed(err: string, ms: int) {
        dialogs.show-test-result(@tr("Test failed: {} ({}ms)", err, ms), false);
    }

    // 识别服务没有「译文」可显示，只报通没通。
    public function show-recognize-test-success(ms: int) {
        dialogs.show-test-result(@tr("Connection OK ({}ms)", ms), true);
    }

    // 微信 OCR 没有可配项，测的是本机装没装、插件下没下，所以回显探到的版本（旧版弹窗的「微信版本」一行）。
    public function show-wechat-test-success(version: string, ms: int) {
        dialogs.show-test-result(@tr("WeChat {} found ({}ms)", version, ms), true);
    }

    // 连不上 Umi 是最常见的一种失败（用户压根没启动它），单独给一句说得清的话。
    public function show-umi-not-running(ms: int) {
        dialogs.show-test-result(@tr("Test failed: cannot reach Umi-OCR. Start Umi-OCR and enable its HTTP interface (default port 1224) ({}ms)", ms), false);
    }

    public function show-fetch-success(count: int) {
        dialogs.show-test-result(@tr("Fetched {} models", count), true);
    }

    public function show-fetch-failed(err: string) {
        dialogs.show-test-result(@tr("Failed to fetch models: {}", err), false);
    }

    public function show-least-services-warning() {
        toast.show(@tr("Please keep at least one translation service"), 2);
    }

    public function show-toast(text: string, kind: int) {
        toast.show(text, kind);
    }

    public function show-save-error(err: string) {
        toast.show(@tr("Could not save settings: {}", err), 2);
    }

    public function show-bad-config(name: string) {
        toast.show(@tr("The settings file could not be read. It was renamed to {} and default settings are used.", name), 2);
    }

    public function show-update-newer(ver: string) {
        toast.show(@tr("Version {} is available on the Releases page", ver), 1);
    }

    public function show-update-latest() {
        toast.show(@tr("You are on the latest version"), 1);
    }

    public function show-update-none() {
        toast.show(@tr("No release published yet"), 0);
    }

    public function show-update-failed(err: string) {
        toast.show(@tr("Update check failed: {}", err), 2);
    }

    public function show-open-url-error(err: string) {
        toast.show(@tr("Could not open link: {}", err), 2);
    }

    public function show-open-path-error(err: string) {
        toast.show(@tr("Could not open folder: {}", err), 2);
    }

    public function show-autostart-error(err: string) {
        toast.show(@tr("Could not change autostart setting: {}", err), 2);
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        title-bar := Rectangle {
            height: 35px;
            background: Theme.content3;
            z: 1;

            HorizontalLayout {
                padding-left: 10px;
                spacing: 0;

                title-drag := TouchArea {
                    horizontal-stretch: 1;
                    moved => {
                        if self.pressed && !root.has-dragged {
                            root.has-dragged = true;
                            root.drag();
                        }
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.has-dragged = false;
                        }
                    }
                    double-clicked => {
                        root.maximized = !root.maximized;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        cross-axis-alignment: center;

                        Image {
                            width: 20px;
                            height: 20px;
                            source: @image-url("../icons/logo.svg");
                        }

                        Text {
                            text: "TiLex";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.foreground;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;

                    // 不套 Tooltip：旧版有气泡，但标题栏这两个键一眼就懂，气泡反而挡着
                    IconButton {
                        size: "round";
                        icon: root.theme-mode == "light" ? @image-url("../icons/light-mode.svg") : (root.theme-mode == "dark" ? @image-url("../icons/dark-mode.svg") : @image-url("../icons/settings-brightness.svg"));
                        color: Theme.icon-normal;
                        label: @tr("Theme");
                        clicked => {
                            root.cycle-theme();
                        }
                    }

                    LanguageButton {
                        language: root.language;
                        clicked => {
                            root.toggle-language();
                        }
                    }

                    Rectangle {
                        width: 4px;
                    }
                }

                HorizontalLayout {
                    spacing: 0px;

                    min-btn := Rectangle {
                        width: 35px;
                        height: 35px;
                        background: min-touch.pressed ? Theme.default-200 : (min-touch.has-hover ? Theme.default-base.with-alpha(0.4) : Colors.transparent);
                        accessible-role: AccessibleRole.button;
                        accessible-label: @tr("Minimize");

                        min-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.minimized = true;
                            }
                        }

                        Image {
                            width: 16px;
                            height: 16px;
                            source: @image-url("../icons/chrome-minimize.svg");
                            colorize: Theme.foreground;
                        }
                    }

                    max-btn := Rectangle {
                        width: 35px;
                        height: 35px;
                        background: max-touch.pressed ? Theme.default-200 : (max-touch.has-hover ? Theme.default-base.with-alpha(0.4) : Colors.transparent);
                        accessible-role: AccessibleRole.button;
                        accessible-label: root.maximized ? @tr("Restore") : @tr("Maximize");

                        max-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.maximized = !root.maximized;
                            }
                        }

                        Image {
                            width: 16px;
                            height: 16px;
                            source: root.maximized ? @image-url("../icons/chrome-restore.svg") : @image-url("../icons/chrome-maximize.svg");
                            colorize: Theme.foreground;
                        }
                    }

                    close-btn := Rectangle {
                        width: 35px;
                        height: 35px;
                        background: close-touch.has-hover || close-touch.pressed ? Theme.window-close-hover : Colors.transparent;
                        accessible-role: AccessibleRole.button;
                        accessible-label: @tr("Close");
                        animate background { duration: 150ms; }

                        close-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.close-clicked();
                            }
                        }

                        Image {
                            width: 16px;
                            height: 16px;
                            source: @image-url("../icons/chrome-close.svg");
                            colorize: close-touch.has-hover || close-touch.pressed ? Theme.primary-foreground : Theme.foreground;
                        }
                    }
                }
            }
        }

        tab-bar := Rectangle {
            height: 52px;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.default-200;
            }

            tab-drag := TouchArea {
                width: 100%;
                height: 100%;
                moved => {
                    if self.pressed && !root.has-dragged {
                        root.has-dragged = true;
                        root.drag();
                    }
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.has-dragged = false;
                    }
                }
                double-clicked => {
                    root.maximized = !root.maximized;
                }
            }

            HorizontalLayout {
                alignment: center;
                cross-axis-alignment: center;

                PillTabs {
                    shape: "full";
                    tabs: [
                        @tr("Translate"),
                        @tr("Services"),
                        @tr("Wordbook"),
                        @tr("About"),
                    ];
                    current <=> root.page;
                }
            }
        }

        page-area := Rectangle {
            vertical-stretch: 1;

            // 点空白处收掉输入框焦点：Slint 只在点到另一个可聚焦控件时才转移焦点，
            // 不然光标会一直留在黑名单输入框里（用户报的）。这个 FocusScope 只是个接焦点的空壳。
            blur-catcher := FocusScope {
                width: 0px;
                height: 0px;
                focus-on-tab-navigation: false;
            }

            // 放在 scroll 前面 = 画在底下，只有上面没人接的点击才落到这儿
            TouchArea {
                clicked => {
                    blur-catcher.focus();
                }
            }

            scroll := ScrollArea {
                // ScrollView 自动算的 viewport 高度用的是子布局的 min-height（编译器 passes/flickable.rs），
                // 而 SettingRow 写死 min-height: 40px，比实际行高小，算出来的 viewport 撑不到内容高度，页面就滚不动。
                // 显式绑定 preferred-height 跳过那条自动规则；页面比可视区短时取可视高度，免得 viewport 比窗口还小。
                viewport-height: max(self.visible-height, content.preferred-height);

                content := VerticalLayout {
                    // 窗口放大后内容列不设宽度封顶，所有页卡片均填满可用宽度（R7：用户要求各页卡片跟随窗口宽度放大，行为一致）。
                    // 左右内边距保持现状：关于页（page == 3）通栏出血为 0，其余页为 10px。
                    // 默认 800×600 下 parent.width 本就小于 1200px，去掉封顶逐像素不变
                    //（slint-ui.md §7 的量图对照不受影响）。
                    width: parent.width;
                    padding-left: root.page == 3 ? 0px : 10px;
                    padding-right: root.page == 3 ? 0px : 10px;
                    padding-top: root.page == 3 ? 0px : 10px;
                    padding-bottom: root.page == 3 ? 0px : 10px;
                    alignment: start;

                    if root.page == 0 : TranslatePage { }

                    if root.page == 1 : ServicesPage {
                        available-height: scroll.visible-height - 20px;
                        translate-services: root.translate-services;
                        recognize-services: root.recognize-services;
                        set-service-enabled(kind, idx, enabled) => {
                            root.set-service-enabled(kind, idx, enabled);
                        }
                        remove-service(kind, idx) => {
                            root.remove-service(kind, idx);
                        }
                        move-service(kind, from, to) => {
                            root.move-service(kind, from, to);
                        }
                        add-service(kind) => {
                            root.dialog-kind = kind;
                            // 识别服务只有内置的（旧版 Recognize/index.jsx 也是一层），
                            // 不走「内置 / AI」那层选择。
                            root.dialog = kind == "recognize" ? 2 : 1;
                        }
                        edit-service(kind, idx) => {
                            root.edit-service(kind, idx);
                        }
                    }

                    // 撑满可视区（减掉 content 的上下 padding），同 ServicesPage
                    if root.page == 2 : WordbookPage {
                        height: scroll.visible-height - 20px;
                    }

                    if root.page == 3 : AboutPage {
                        version: root.version;
                        autostart-enabled <=> root.autostart-enabled;
                        autostart-supported: root.autostart-supported;
                        checking-update: root.checking-update;
                        credits: root.credits;
                        open-url(url) => { root.open-url(url); }
                        open-github => { root.open-github(); }
                        open-feedback => { root.open-feedback(); }
                        open-releases => { root.open-releases(); }
                        autostart-toggled(on) => { root.autostart-toggled(on); }
                        check-update => { root.check-update(); }
                        view-log => { root.view-log(); }
                        view-config => { root.view-config(); }
                    }
                }
            }
        }
    }

    dialogs := ServiceDialogs {
        dialog <=> root.dialog;
        dialog-kind <=> root.dialog-kind;
        dialog-service <=> root.dialog-service;
        dialog-index <=> root.dialog-index;

        draft-label <=> root.draft-label;
        draft-google-mode-index <=> root.draft-google-mode-index;
        draft-google-custom-url <=> root.draft-google-custom-url;
        draft-google-api-key <=> root.draft-google-api-key;
        draft-google-custom-api-url <=> root.draft-google-custom-api-url;

        draft-ai-base-url <=> root.draft-ai-base-url;
        draft-ai-api-key <=> root.draft-ai-api-key;
        draft-ai-model <=> root.draft-ai-model;
        draft-ai-protocol-index <=> root.draft-ai-protocol-index;
        draft-ai-custom-instructions <=> root.draft-ai-custom-instructions;
        draft-ai-icon <=> root.draft-ai-icon;
        draft-ai-has-logo <=> root.draft-ai-has-logo;
        draft-ai-icon-color <=> root.draft-ai-icon-color;
        draft-ai-icon-letter <=> root.draft-ai-icon-letter;

        draft-bing-mode-index <=> root.draft-bing-mode-index;
        draft-bing-auth-key <=> root.draft-bing-auth-key;
        draft-bing-region <=> root.draft-bing-region;
        draft-bing-custom-url <=> root.draft-bing-custom-url;

        draft-deepl-mode-index <=> root.draft-deepl-mode-index;
        draft-deepl-auth-key <=> root.draft-deepl-auth-key;
        draft-deepl-custom-url <=> root.draft-deepl-custom-url;

        draft-baidu-appid <=> root.draft-baidu-appid;
        draft-baidu-secret <=> root.draft-baidu-secret;

        draft-umi-url <=> root.draft-umi-url;

        resolved-chat-url <=> root.resolved-chat-url;
        ai-presets: root.ai-presets;
        default-ai-custom-instructions: root.default-ai-custom-instructions;

        window-height: root.height;
        wechat-icon-color: root.wechat-icon-color;
        umi-icon-color: root.umi-icon-color;
        recognize-has-wechat: root.recognize-has-wechat;
        recognize-has-umi: root.recognize-has-umi;
        testing: root.testing-service;
        fetching: root.fetching-models;
        ai-models: root.ai-models;
        ai-model-names: root.ai-model-names;
        ai-model-index <=> root.ai-model-index;
        bench-running: root.bench-running;
        bench-current: root.bench-current;
        bench-remaining: root.bench-remaining;
        bench-tested: root.bench-tested;
        bench-failed: root.bench-failed;

        refresh-resolved-url(base, model, protocol, locked-icon) => {
            root.refresh-resolved-url(base, model, protocol, locked-icon);
        }
        save-service(draft) => {
            root.save-service(draft);
        }
        test-service(draft) => {
            root.test-service(draft);
        }
        fetch-models(draft) => {
            root.fetch-models(draft);
        }
        start-benchmark(draft, force) => {
            root.start-benchmark(draft, force);
        }
        stop-benchmark(draft) => {
            root.stop-benchmark(draft);
        }
    }

    // 生词本的删除确认框：Modal 必须在窗口根上才能铺满整窗（§2），所以放这儿而不是 wordbook.slint 里
    Modal {
        open: WordbookState.delete-modal-open;
        size: "sm";
        title: @tr("Delete {} entries?", WordbookState.delete-modal-count);
        dismissable: !WordbookState.deleting;
        closed => {
            WordbookState.cancel-delete();
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            Button {
                size: "sm";
                variant: "light";
                text: @tr("Cancel");
                enabled: !WordbookState.deleting;
                clicked => {
                    WordbookState.cancel-delete();
                }
            }

            Button {
                size: "sm";
                variant: "solid";
                color: "danger";
                text: @tr("Delete {} entries", WordbookState.delete-modal-count);
                loading: WordbookState.deleting;
                enabled: !WordbookState.deleting;
                clicked => {
                    WordbookState.confirm-delete();
                }
            }
        }
    }

    // 窗口正中（用户 B2 F7 手测时定的；旧版 react-hot-toast 是 top-center top:45）
    toast := Toast {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}
