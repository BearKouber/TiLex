import { Theme } from "../common/theme.slint";

export component ServiceIcon {
    in property <string> id: "";
    in property <bool> has-logo: false;
    in property <brush> icon-color: Theme.foreground;
    in property <string> icon-letter: "";
    in property <length> size: 24px;

    width: root.size;
    height: root.size;

    if root.id == "google" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/google.svg");
    }
    if root.id == "bing" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/bing.svg");
    }
    if root.id == "deepl" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/deepl.svg");
    }
    if root.id == "baidu" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/baidu.svg");
    }
    if root.id == "transmart" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/transmart.png");
    }
    if root.id == "openai" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/openai.svg");
    }
    if root.id == "deepseek" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/deepseek.svg");
    }
    // 以下 8 个来自 simple-icons，都是单路径单色图，用品牌色上色（来源见 NOTICE.md）
    if root.id == "claude" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/claude.svg");
        colorize: root.icon-color;
    }
    if root.id == "gemini" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/gemini.svg");
        colorize: root.icon-color;
    }
    if root.id == "qwen" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/qwen.svg");
        colorize: root.icon-color;
    }
    if root.id == "copilot" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/copilot.svg");
        colorize: root.icon-color;
    }
    if root.id == "ollama" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/ollama.svg");
        colorize: root.icon-color;
    }
    if root.id == "kimi" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/kimi.svg");
        colorize: root.icon-color;
    }
    // MiMo 是小米自研模型，simple-icons 没有 MiMo 专属图标，用小米的厂商 logo
    if root.id == "mimo" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/mimo.svg");
        colorize: root.icon-color;
    }
    // Grok 同理：simple-icons 没有 Grok/xAI，用同一家的 X logo
    if root.id == "grok" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/grok.svg");
        colorize: root.icon-color;
    }
    // 单色图标，用品牌色上色（旧版 RiWechatFill + #07C160）
    if root.id == "wechat" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/wechat.svg");
        colorize: root.icon-color;
    }
    // 同样是单色图标：Umi-OCR 没有 logo，旧版用的是通用「文字识别」图标
    if root.id == "umi" : Image {
        width: root.size;
        height: root.size;
        source: @image-url("../icons/logo/umi.svg");
        colorize: root.icon-color;
    }
    if !root.has-logo : Rectangle {
        width: root.size;
        height: root.size;
        border-radius: root.size * 0.25;
        background: root.icon-color;

        Text {
            text: root.icon-letter;
            font-size: root.size * 0.54;
            font-weight: 700;
            color: Theme.primary-foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
