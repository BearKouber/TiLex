// ui.md §5.5 TextField / TextArea（旧版 NextUI Input / Textarea）
import { Theme } from "theme.slint";

export component TextField {
    // 变体："bordered"（md 高 40，圆角 12）或 "flat"（sm 高 32，圆角 8）
    in property <string> variant: "bordered";
    // 输入文本内容
    in-out property <string> text: "";
    // 占位文字
    in property <string> placeholder: "";
    // 密码模式：右侧显示显示/隐藏密码按钮
    in property <bool> password: false;
    // 是否可清除：有文字时右侧显示清除按钮
    in property <bool> clearable: false;
    // 文字是否居中（快捷键框使用）
    in property <bool> center: false;
    // 是否只读
    in property <bool> read-only: false;
    // 是否启用：禁用时透明度 0.5
    in property <bool> enabled: true;
    // 文字比框宽时缩字号（快捷键框用）
    in property <bool> auto-shrink: false;

    // 每次输入文本变动回调
    callback edited(string);
    // 按 Enter 提交回调
    callback accepted(string);
    // 结束编辑回调（Enter 或失焦，只调一次，Enter 后失焦不重复调用）
    callback editing-finished(string);

    public function select-all() {
        text-input.select-all();
    }

    // 焦点状态（快捷键框要用）
    out property <bool> has-focus: text-input.has-focus;
    // 按键透传：返回 accept 就把这一下吃掉，TextInput 不再处理。默认 reject，不影响别的用法。
    callback key-pressed(event: KeyEvent) -> EventResult;

    private property <bool> is-bordered: root.variant == "bordered";
    private property <bool> password-revealed: false;
    // 记录本轮编辑是否已触发过 editing-finished，避免 Enter 后失焦重复触发
    private property <bool> finished-called: true;
    private property <length> min-font-size: 10px;
    private property <length> base-font-size: root.is-bordered ? 14px : 12px;
    private property <length> available-width: max(0px, root.width - (root.is-bordered ? 24px : 16px));
    private property <length> shown-font-size: (root.auto-shrink && root.available-width > 0px && measure.preferred-width > root.available-width)
        ? max(root.min-font-size, root.base-font-size * (root.available-width / measure.preferred-width))
        : root.base-font-size;

    forward-focus: text-input;

    height: root.is-bordered ? 40px : 32px;
    opacity: root.enabled ? 1.0 : 0.5;
    animate opacity { duration: 150ms; }

    accessible-role: AccessibleRole.text-input;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder;
    accessible-enabled: root.enabled;
    accessible-read-only: root.read-only;

    measure := Text {
        width: 0px;
        height: 0px;
        visible: false;
        font-size: root.base-font-size;
        text: root.text == "" ? root.placeholder : root.text;
    }

    shell := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.is-bordered ? Theme.radius-medium : Theme.radius-small;
        border-width: 1px;
        border-color: root.is-bordered
            ? (text-input.has-focus ? Theme.default-400 : (touch-area.has-hover ? Theme.default-400 : Theme.default-200))
            : (text-input.has-focus ? Theme.default-400 : transparent);
        background: root.is-bordered
            ? Theme.content1
            : (text-input.has-focus ? Theme.default-200 : (touch-area.has-hover ? Theme.default-200 : Theme.default-100));

        animate border-color, background { duration: 150ms; }

        // 背景点击聚焦与悬停检测，置于底层避免干扰 TextInput 自身的鼠标选区操作
        touch-area := TouchArea {
            enabled: root.enabled;
            width: 100%;
            height: 100%;
            mouse-cursor: MouseCursor.text;

            clicked => {
                text-input.focus();
            }
        }

        HorizontalLayout {
            padding-left: root.is-bordered ? 12px : 8px;
            padding-right: root.is-bordered ? 12px : 8px;
            spacing: 6px;

            input-container := Rectangle {
                horizontal-stretch: 1;
                // 长文本不许把控件撑大：`TextInput` 的 preferred-width 是整段文字的宽度，
                // 会一路顶穿 SettingRow、对话框直到窗口外。容器自己夹住宽度（显式 min-width
                // 盖掉子元素传上来的约束）+ clip，文字在框内随光标横向滚。
                // 做法照 Slint 自己的 `widgets/common/lineedit-base.slint`（1px 而不是 0：
                // 宽度小于 1px 或被完全裁掉时 TextInput 聚焦不了，是它注释里写明的）。
                min-width: 1px;
                clip: true;

                // 占位文字
                if (root.text == "" && text-input.preedit-text == "") : Text {
                    width: 100%;
                    height: 100%;
                    vertical-alignment: TextVerticalAlignment.center;
                    horizontal-alignment: root.center ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
                    text: root.placeholder;
                    font-size: root.shown-font-size;
                    color: Theme.default-400;
                }

                text-input := TextInput {
                    // 光标驱动的横向滚动（同上，照 lineedit-base）：文字比框宽时才真的比框宽，
                    // 再靠 x 把光标那一段拉进可视范围；文字短的时候宽度还是等于框宽（居中对齐要用）。
                    property <length> computed-x;

                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                    height: 100%;
                    vertical-alignment: TextVerticalAlignment.center;
                    horizontal-alignment: root.center ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
                    font-size: root.shown-font-size;
                    color: Theme.foreground;
                    single-line: true;
                    enabled: root.enabled;
                    read-only: root.read-only;
                    text <=> root.text;
                    input-type: (root.password && !root.password-revealed) ? InputType.password : InputType.text;

                    cursor-position-changed(cursor-position) => {
                        if cursor-position.x + self.computed-x < 0px {
                            self.computed-x = -cursor-position.x;
                        } else if cursor-position.x + self.computed-x > parent.width - self.text-cursor-width {
                            self.computed-x = parent.width - cursor-position.x - self.text-cursor-width;
                        }
                    }

                    key-pressed(event) => { root.key-pressed(event) }

                    changed has-focus => {
                        if self.has-focus {
                            root.finished-called = false;
                        } else {
                            if !root.finished-called {
                                root.finished-called = true;
                                root.editing-finished(root.text);
                            }
                        }
                    }

                    edited => {
                        root.finished-called = false;
                        root.edited(self.text);
                    }

                    accepted => {
                        root.accepted(self.text);
                        if !root.finished-called {
                            root.finished-called = true;
                            root.editing-finished(self.text);
                        }
                    }
                }
            }

            // 清除按钮（有文字且 clearable 时显示，点击不抢焦点、不触发 editing-finished）
            if (root.clearable && root.text != "" && !root.read-only && root.enabled) : clear-btn := Rectangle {
                width: 20px;
                height: 100%;

                FocusScope {
                    focus-on-click: false;
                    focus-on-tab-navigation: false;
                    width: 100%;
                    height: 100%;

                    clear-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;

                        clicked => {
                            root.text = "";
                            root.finished-called = false;
                            root.edited("");
                        }

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            source: @image-url("../icons/x.svg");
                            colorize: clear-touch.has-hover ? Theme.foreground : Theme.default-400;
                            accessible-role: button;
                            accessible-label: @tr("Clear");
                        }
                    }
                }
            }

            // 密码切换眼睛按钮（password 为 true 时显示，点击不抢焦点、不触发 editing-finished）
            if root.password : eye-btn := Rectangle {
                width: 20px;
                height: 100%;

                FocusScope {
                    focus-on-click: false;
                    focus-on-tab-navigation: false;
                    width: 100%;
                    height: 100%;

                    eye-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;

                        clicked => {
                            root.password-revealed = !root.password-revealed;
                        }

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            source: root.password-revealed
                                ? @image-url("../icons/eye.svg")
                                : @image-url("../icons/eye-off.svg");
                            colorize: eye-touch.has-hover ? Theme.foreground : Theme.default-400;
                            accessible-role: button;
                            accessible-label: root.password-revealed ? @tr("Hide password") : @tr("Show password");
                        }
                    }
                }
            }
        }
    }
}

export component TextArea {
    // 文本内容
    in-out property <string> text: "";
    // 占位文字
    in property <string> placeholder: "";
    // 是否只读
    in property <bool> read-only: false;
    // 是否启用：禁用时透明度 0.5
    in property <bool> enabled: true;

    // 文本编辑回调
    callback edited(string);

    public function select-all() {
        text-input.select-all();
    }

    forward-focus: text-input;

    // 随内容长高（auto-expand），最小 80px
    height: max(80px, text-input.preferred-height + 24px);
    opacity: root.enabled ? 1.0 : 0.5;
    animate opacity { duration: 150ms; }

    accessible-role: AccessibleRole.text-input;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder;
    accessible-enabled: root.enabled;
    accessible-read-only: root.read-only;

    shell := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-medium;
        border-width: 1px;
        border-color: text-input.has-focus
            ? Theme.default-400
            : (touch-area.has-hover ? Theme.default-400 : Theme.default-200);
        background: Theme.content1;

        animate border-color, background { duration: 150ms; }

        touch-area := TouchArea {
            enabled: root.enabled;
            width: 100%;
            height: 100%;
            mouse-cursor: MouseCursor.text;

            clicked => {
                text-input.focus();
            }
        }

        Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;

            if (root.text == "" && text-input.preedit-text == "") : Text {
                x: 0;
                y: 0;
                width: 100%;
                text: root.placeholder;
                font-size: 14px;
                color: Theme.default-400;
                wrap: word-wrap;
            }

            text-input := TextInput {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                font-size: 14px;
                color: Theme.foreground;
                single-line: false;
                wrap: word-wrap;
                enabled: root.enabled;
                read-only: root.read-only;
                text <=> root.text;

                edited => {
                    root.edited(self.text);
                }
            }
        }
    }
}
