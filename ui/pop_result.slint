import { EntryBody, EntryView } from "common/entry_view.slint";
import { IconButton } from "common/icon_button.slint";
import { LoadingDots } from "common/loading_dots.slint";
import { ServiceName } from "common/service_name.slint";
import { Theme } from "common/theme.slint";
import { Palette, ScrollView } from "std-widgets.slint";

export struct ResultRow {
    service-id: string,
    kind: string,
    label: string,
    collapsed: bool,
    loading: bool,
    text: string,
    error: string,
    display: EntryView,
}

component ServiceHeader inherits Rectangle {
    height: 20px;
    in property <ResultRow> item;
    in property <bool> speaking;
    in property <bool> copied;
    in property <bool> saved;

    callback toggle();
    callback speak();
    callback copy();
    callback save();

    header-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 20px;
            spacing: 2px;
            cross-axis-alignment: center;

            // 折叠箭头（左）
            Image {
                source: root.item.collapsed ? @image-url("icons/chevron-right.svg") : @image-url("icons/chevron-down.svg");
                colorize: Theme.icon-muted;
                width: 12px;
                height: 12px;
            }

            // 服务名
            Text {
                text: root.item.label != "" ? root.item.label : ServiceName.display(root.item.kind);
                color: Theme.default-400;
                font-size: 10px;
                vertical-alignment: center;
            }

            // 弹性空白
            Rectangle {
                horizontal-stretch: 1;
            }

            // 朗读、复制、收藏（右）
            if !root.item.loading && root.item.error == "" && root.item.text != "" : HorizontalLayout {
                IconButton {
                    size: "tiny";
                    icon: @image-url("icons/volume-2.svg");
                    checked-icon: @image-url("icons/square.svg");
                    checked: root.speaking;
                    checked-color: Theme.icon-active;
                    label: self.checked ? @tr("Stop") : @tr("Speak");
                    revealed: header-touch.has-hover;
                    clicked => {
                        root.speak();
                    }
                }

                IconButton {
                    size: "tiny";
                    icon: @image-url("icons/copy.svg");
                    checked-icon: @image-url("icons/check.svg");
                    checked: root.copied;
                    checked-color: Theme.icon-done;
                    label: @tr("Copy");
                    revealed: header-touch.has-hover;
                    clicked => {
                        root.copy();
                    }
                }

                IconButton {
                    size: "tiny";
                    icon: @image-url("icons/star.svg");
                    checked-icon: @image-url("icons/check.svg");
                    checked: root.saved;
                    checked-color: Theme.icon-done;
                    label: self.checked ? @tr("Saved to wordbook") : @tr("Add to wordbook");
                    revealed: header-touch.has-hover;
                    clicked => {
                        root.save();
                    }
                }
            }
        }
    }
}

export component PopResult inherits Window {
    title: "TiLex PopResult";
    icon: @image-url("icons/app.png");
    no-frame: true;
    always-on-top: true;
    width: 320px; // 与 logic::placement::RESULT_WIDTH 一致
    // ponytail: 和浮标同一招（platform-windows.md §1 第 4c 条）。软件渲染只提交脏区域，
    // 置顶的浮窗在用户切走/切回时系统会丢掉窗口画面，从不变化的顶栏拖动区就一直透明。
    // 翻转 repaint-tick 产生肉眼分不出的色差，让整窗变脏重画一次。
    // 以后 Slint 提供整窗强制重绘接口时换掉。
    in property <bool> repaint-tick;
    background: root.repaint-tick ? Theme.content1 : Theme.content1.darker(0.01);
    forward-focus: focus-scope;
    // 跟设置窗一致用细体（见 settings/window.slint）
    default-font-weight: Theme.font-weight;
    default-font-family: Theme.font-family;

    in-out property <ColorScheme> color-scheme <=> Palette.color-scheme;
    in property <string> source-text;
    in property <bool> is-pinned;
    in property <[ResultRow]> rows;
    in property <string> lang-badge: "";
    // 截图识别的顶栏状态（原文还没出来时才显示）：识别中转圈，或者一句红字说明为什么没出字。
    in property <bool> recognizing: false;
    // 0 无 / 1 图里没有文字 / 2 没有可用的识别服务 / 3 Umi-OCR 未运行 / 4 识别失败
    // （编号由 `logic::recognize` 给，Rust 不拼界面中文，design §2.9）
    in property <int> recognize-error: 0;
    in property <int> speaking-key: -2;
    in property <int> copied-key: -2;
    in property <int> saved-row: -1;
    // 鼠标在浮窗里移动超过 24px 后为真（Rust 按 winit 光标事件算，每次显示复位），之后左上角红三角才生效。
    in property <bool> close-armed;

    callback close-requested();
    callback pin-toggled();
    callback drag-started();
    callback dragged(length, length);
    callback toggle-collapse(int);
    callback speak-clicked(int);
    callback copy-clicked(int);
    callback save-clicked(int);
    callback content-height-changed();

    out property <length> content-height: header.height + rows-layout.preferred-height;

    changed content-height => {
        root.content-height-changed();
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-requested();
                return accept;
            }
            reject
        }

        content-layout := VerticalLayout {
            // Header
            header := Rectangle {
                height: 24px;
                // 不自己铺底色：窗口背景本来就是 content1，再铺一层会和 repaint-tick 的微小色差错开，露出一条边

                header-drag := TouchArea {
                    moved => {
                        if self.pressed {
                            root.dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            root.drag-started();
                        }
                    }

                    // 布局默认 stretch 会把定高的按钮顶到上沿，要显式居中。
                    // 右边距 20：14px 滑块宽 + 6px 离滑块间隙，与服务行按钮列右边缘对齐（R1）
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 20px;
                        spacing: 4px;
                        cross-axis-alignment: center;

                        // 语种徽标：主题色六成透明度、不加粗（旧版 text-primary/60）
                        if root.lang-badge != "" : Text {
                            text: root.lang-badge;
                            color: Theme.primary.with-alpha(0.6);
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        // 原文：11px 淡灰（旧版顶栏 text-[11px] text-default-400）。
                        // 截图识别时原文要等识别完才有，这段位置先给「识别中」或失败说明（旧版 `PopResult:372-379`）。
                        if root.source-text != "" || (!root.recognizing && root.recognize-error == 0) : Text {
                            text: root.source-text;
                            wrap: no-wrap;
                            overflow: elide;
                            color: Theme.default-400;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        if root.source-text == "" && root.recognizing : HorizontalLayout {
                            spacing: 6px;
                            cross-axis-alignment: center;
                            horizontal-stretch: 1;

                            LoadingDots {
                                width: 16px;
                                height: 4px;
                            }

                            Text {
                                text: @tr("Recognizing…");
                                color: Theme.default-400;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }

                        if root.source-text == "" && !root.recognizing && root.recognize-error != 0 : Text {
                            text: root.recognize-error == 1 ? @tr("No text found in the selected area")
                                : root.recognize-error == 2 ? @tr("No text recognition service is enabled — turn one on in Service Settings")
                                : root.recognize-error == 3 ? @tr("Cannot reach Umi-OCR. Start Umi-OCR and enable its HTTP interface (default port 1224)")
                                : @tr("Text recognition failed. Please try again.");
                            wrap: no-wrap;
                            overflow: elide;
                            color: Theme.danger;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        // 右侧按钮挨着排：16px 热区里 12px 图标，间距 0 时图标之间正好 4px（旧版 gap-[4px]）
                        HorizontalLayout {
                            if root.source-text != "" : IconButton {
                                size: "tiny";
                                icon: @image-url("icons/volume-2.svg");
                                checked-icon: @image-url("icons/square.svg");
                                checked: root.speaking-key == -1;
                                checked-color: Theme.icon-active;
                                label: self.checked ? @tr("Stop") : @tr("Speak");
                                revealed: header-drag.has-hover;
                                clicked => {
                                    root.speak-clicked(-1);
                                }
                            }

                            if root.source-text != "" : IconButton {
                                size: "tiny";
                                icon: @image-url("icons/copy.svg");
                                checked-icon: @image-url("icons/check.svg");
                                checked: root.copied-key == -1;
                                checked-color: Theme.icon-done;
                                label: @tr("Copy");
                                revealed: header-drag.has-hover;
                                clicked => {
                                    root.copy-clicked(-1);
                                }
                            }

                            // 钉子：常显，旧版的斜钉子，钉住实心。和服务行按钮同一个 IconButton，列才对得齐
                            IconButton {
                                size: "tiny";
                                icon: @image-url("icons/pin-angle.svg");
                                checked-icon: @image-url("icons/pin-angle-fill.svg");
                                checked: root.is-pinned;
                                checked-color: Theme.icon-active;
                                label: self.checked ? @tr("Unpin") : @tr("Pin");
                                clicked => {
                                    root.pin-toggled();
                                }
                            }
                        }
                    }
                }
            }

            // Scrollable content
            scroll-view := ScrollView {
                rows-layout := VerticalLayout {
                    padding-bottom: 4px;
                    spacing: 4px;

                    for row[idx] in root.rows : row-item := Rectangle {
                        width: 100%;
                        height: row-content.preferred-height;

                        property <length> next-row-spacing: (idx + 1 < root.rows.length) ? 4px : 0px;
                        property <length> bottom-y: self.y + self.height + self.next-row-spacing + scroll-view.viewport-y;
                        property <bool> is-sticky: self.y + scroll-view.viewport-y < 0px && self.bottom-y > 0px;
                        property <length> push-y: min(0px, self.bottom-y - 20px);
                        property <length> sticky-y: -self.y - scroll-view.viewport-y + self.push-y;

                        row-content := VerticalLayout {
                            width: 100%;
                            height: 100%;
                            spacing: 2px;

                            // Service header
                            row-header := ServiceHeader {
                                item: row;
                                speaking: root.speaking-key == idx;
                                copied: root.copied-key == idx;
                                saved: root.saved-row == idx;
                                toggle => {
                                    root.toggle-collapse(idx);
                                }
                                speak => {
                                    root.speak-clicked(idx);
                                }
                                copy => {
                                    root.copy-clicked(idx);
                                }
                                save => {
                                    root.save-clicked(idx);
                                }
                            }

                            // Service result / status
                            if !row.collapsed : Rectangle {
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 20px;
                                    padding-top: 2px;
                                    padding-bottom: 6px;

                                    if row.loading : LoadingDots { }

                                    if !row.loading && row.error != "" : Text {
                                        text: row.error;
                                        color: Theme.danger;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }

                                    if !row.loading && row.error == "" : EntryBody {
                                        entry: row.display;
                                        // 窗口只有 320px 宽，用旧版 TranslationResult 的 compact 版式
                                        compact: true;
                                        // 左右各 8px/20px 内边距。宽度取窗口的固定宽（布局之外的来源，§3.45）
                                        content-width: root.width - 28px;
                                    }
                                }
                            }
                        }

                        // Sticky header overlay when scrolled past top (R2)
                        if row-item.is-sticky : ServiceHeader {
                            x: 0;
                            y: row-item.sticky-y;
                            width: 100%;
                            background: Theme.content1;
                            item: row;
                            speaking: root.speaking-key == idx;
                            copied: root.copied-key == idx;
                            saved: root.saved-row == idx;
                            toggle => {
                                root.toggle-collapse(idx);
                            }
                            speak => {
                                root.speak-clicked(idx);
                            }
                            copy => {
                                root.copy-clicked(idx);
                            }
                            save => {
                                root.save-clicked(idx);
                            }
                        }
                    }
                }
            }
        }
    }

    // 1px 内描边（旧版 border-1 border-default-200）。不用 DWM 的 DWMWA_BORDER_COLOR：
    // 那条线画在客户区外面，左上角的红三角盖不住，边角会露出一圈浅灰。
    Rectangle {
        width: 100%;
        height: 100%;
        border-width: 1px;
        border-color: Theme.default-200;
        border-radius: 8px; // 与 DWMWCP_ROUND 的圆角一致
    }

    // 左上角红三角（旧版 PopResult:328-343）：close-armed 之后，悬停或点击即关闭。放在最后才盖在顶栏和描边上面。
    corner := TouchArea {
        x: 0;
        y: 0;
        width: 14px;
        height: 14px;
        // TouchArea 只有矩形，而画出来的是三角形：这个 14×14 的方块里，斜边右下那一半
        // 是顶栏的空白，悬停到那儿不该关窗口（悬停即关，连点都不用点，误触很凶）。
        // 斜边在本坐标系里是 x+y=11：Path 从 (-3,-3) 起画，viewbox 里的斜边是 x+y=17，
        // 平移 3px 就成了 11。**不是 14** —— 14 是这个 TouchArea 的边长，别混。
        property <bool> on-triangle: self.has-hover && self.mouse-x + self.mouse-y <= 11px;
        // 指针也跟着收，不然鼠标在空白半边上变成手型，看着像能点。
        mouse-cursor: self.on-triangle ? MouseCursor.pointer : MouseCursor.default;
        accessible-role: button;
        accessible-label: @tr("Close");
        // 盯 on-triangle 而不是 has-hover：从空白半边横着挪进三角时 has-hover 一直为真、
        // 不会再触发 changed，那样就点不着了。
        changed on-triangle => {
            if self.on-triangle && root.close-armed {
                root.close-requested();
            }
        }
        clicked => {
            if root.close-armed && self.mouse-x + self.mouse-y <= 11px {
                root.close-requested();
            }
        }

        // 往左上多画 3px：窗口圆角会切掉三角的尖，画到边界外面才填得满，
        // 多出来的部分被窗口边缘裁掉。斜边落在 TouchArea 坐标的 x+y=11 上（见上面的命中判定）。
        Path {
            x: -3px;
            y: -3px;
            width: 17px;
            height: 17px;
            viewbox-width: 17;
            viewbox-height: 17;
            commands: "M0 0 L17 0 L0 17 Z";
            fill: corner.has-hover ? Theme.danger.darker(0.2) : Theme.danger;
        }
    }
}
