// ui.md §6.3 设置窗口骨架。旧版 TiLex/src/window/Config/index.jsx。
import { AboutPage } from "about.slint";
import { ServicesPage, ServiceRow } from "services.slint";
import { ServiceDialogs } from "service_dialogs.slint";
import { TranslatePage } from "translate.slint";
import { Card } from "../common/card.slint";
import { IconButton } from "../common/icon_button.slint";
import { PillTabs } from "../common/pill_tabs.slint";
import { Theme } from "../common/theme.slint";
import { Toast } from "../common/toast.slint";
import { ScrollArea } from "../common/scroll_area.slint";
import { Palette } from "std-widgets.slint";

component LanguageButton {
    in property <string> language: "zh_CN";
    in property <bool> enabled: true;
    callback clicked();

    property <bool> kb-focus: false;

    forward-focus: fs;
    width: 26px;
    height: 26px;
    accessible-role: AccessibleRole.button;
    accessible-label: @tr("Interface language");

    // 键盘 Tab 焦点环（比控件大 2px，圆角 +2）
    if root.kb-focus : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 15px;
        border-width: 2px;
        border-color: Theme.focus;
    }

    bg := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 13px;

        background: touch.pressed
            ? Theme.default-200
            : (touch.has-hover ? Theme.default-base.with-alpha(0.4) : Colors.transparent);

        opacity: root.enabled ? 1.0 : 0.5;

        // 底色不做过渡，理由见 icon_button.slint
        animate opacity { duration: 150ms; }

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: root.language == "zh_CN" ? "中" : "EN";
            font-size: 12px;
            font-weight: 700;
            color: Theme.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    fs := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        focus-gained(reason) => {
            root.kb-focus = reason == FocusReason.tab-navigation;
        }
        focus-lost(reason) => {
            root.kb-focus = false;
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }

        touch := TouchArea {
            width: 100%;
            height: 100%;
            enabled: root.enabled;
            mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                root.clicked();
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: @tr("TiLex Settings");
    no-frame: true;
    resize-border-width: 5px;
    min-width: 800px;
    min-height: 400px;
    preferred-width: 800px;
    preferred-height: 600px;
    background: Theme.background;
    // 旧版整套界面的中文落在「微软雅黑 Light」上（量过截图的墨量），Slint 默认 400 会挑 Regular，看着粗一圈。
    // 显式写了 font-weight 的地方（标题 700、正文强调 600）不受影响。
    default-font-weight: 300;

    in-out property <ColorScheme> color-scheme <=> Palette.color-scheme;
    in property <string> theme-mode: "system";
    in property <string> language: "zh_CN";
    in-out property <int> page: 0;

    in property <string> version: "";
    in-out property <bool> autostart-enabled: false;
    in property <bool> autostart-supported: true;
    in property <bool> checking-update: false;
    in property <string> credits-raw: @tr("Based on [pot-desktop](https://github.com/pot-app/pot-desktop) · UI/UX inspired by [Easydict](https://github.com/tisfeng/Easydict) · Tool logic drawn from [STranslate](https://github.com/STranslate/STranslate) · [GPL-3.0](https://github.com/BearKouber/TiLex/blob/HEAD/LICENSE) License");
    in property <styled-text> credits;

    property <bool> has-dragged: false;

    // 无边框窗口从任务栏还原后位置会掉到屏幕左上角（B2 F7 手测），Rust 侧重新居中。
    changed minimized => {
        // 最大化状态还原回来的不用管：它本来就铺满屏幕，再挪位置反而错位
        if !root.minimized && !root.maximized {
            root.restored();
        }
    }

    callback restored();
    callback drag();
    callback cycle-theme();
    callback toggle-language();
    callback close-clicked();

    callback open-url(string);
    callback open-github();
    callback open-feedback();
    callback open-releases();
    callback autostart-toggled(bool);
    callback check-update();
    callback view-log();
    callback view-config();

    // Services Page
    in-out property <[ServiceRow]> translate-services: [];
    in-out property <[ServiceRow]> recognize-services: [];

    callback set-service-enabled(string, int, bool);
    callback remove-service(string, int);
    callback move-service(string, int, int);
    callback edit-service(string, int);

    // Service Dialog Chain
    in-out property <int> dialog: 0;
    in-out property <string> dialog-kind: "translate";
    in-out property <string> dialog-service: "google";
    in-out property <int> dialog-index: -1;

    in-out property <string> draft-label: "";
    in-out property <int> draft-google-mode-index: 0;
    in-out property <string> draft-google-custom-url: "";
    in-out property <string> draft-google-api-key: "";
    in-out property <string> draft-google-custom-api-url: "";

    in property <brush> wechat-icon-color;

    callback add-ai-service(string);
    callback save-service(string, int, string, string, string, string, string, string);

    public function show-least-services-warning() {
        toast.show(@tr("Please keep at least one translation service"), 2);
    }

    public function show-toast(text: string, kind: int) {
        toast.show(text, kind);
    }

    public function show-save-error(err: string) {
        toast.show(@tr("Could not save settings: {}", err), 2);
    }

    public function show-bad-config(name: string) {
        toast.show(@tr("The settings file could not be read. It was renamed to {} and default settings are used.", name), 2);
    }

    public function show-update-newer(ver: string) {
        toast.show(@tr("Version {} is available on the Releases page", ver), 1);
    }

    public function show-update-latest() {
        toast.show(@tr("You are on the latest version"), 1);
    }

    public function show-update-none() {
        toast.show(@tr("No release published yet"), 0);
    }

    public function show-update-failed(err: string) {
        toast.show(@tr("Update check failed: {}", err), 2);
    }

    public function show-open-url-error(err: string) {
        toast.show(@tr("Could not open link: {}", err), 2);
    }

    public function show-open-path-error(err: string) {
        toast.show(@tr("Could not open folder: {}", err), 2);
    }

    public function show-autostart-error(err: string) {
        toast.show(@tr("Could not change autostart setting: {}", err), 2);
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        title-bar := Rectangle {
            height: 35px;
            background: Theme.content3;
            z: 1;

            HorizontalLayout {
                padding-left: 10px;
                spacing: 0;

                title-drag := TouchArea {
                    horizontal-stretch: 1;
                    moved => {
                        if self.pressed && !root.has-dragged {
                            root.has-dragged = true;
                            root.drag();
                        }
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.has-dragged = false;
                        }
                    }
                    double-clicked => {
                        root.maximized = !root.maximized;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        cross-axis-alignment: center;

                        Image {
                            width: 20px;
                            height: 20px;
                            source: @image-url("../icons/logo.svg");
                        }

                        Text {
                            text: "TiLex";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.foreground;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;

                    // 不套 Tooltip：旧版有气泡，但标题栏这两个键一眼就懂，气泡反而挡着
                    IconButton {
                        size: "round";
                        icon: root.theme-mode == "light" ? @image-url("../icons/light-mode.svg") : (root.theme-mode == "dark" ? @image-url("../icons/dark-mode.svg") : @image-url("../icons/settings-brightness.svg"));
                        color: Theme.icon-normal;
                        label: @tr("Theme");
                        clicked => {
                            root.cycle-theme();
                        }
                    }

                    LanguageButton {
                        language: root.language;
                        clicked => {
                            root.toggle-language();
                        }
                    }

                    Rectangle {
                        width: 4px;
                    }
                }

                HorizontalLayout {
                    spacing: 0px;

                    min-btn := Rectangle {
                        width: 35px;
                        height: 35px;
                        background: min-touch.pressed ? Theme.default-200 : (min-touch.has-hover ? Theme.default-base.with-alpha(0.4) : Colors.transparent);
                        accessible-role: AccessibleRole.button;
                        accessible-label: @tr("Minimize");

                        min-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.minimized = true;
                            }
                        }

                        Image {
                            width: 16px;
                            height: 16px;
                            source: @image-url("../icons/chrome-minimize.svg");
                            colorize: Theme.foreground;
                        }
                    }

                    max-btn := Rectangle {
                        width: 35px;
                        height: 35px;
                        background: max-touch.pressed ? Theme.default-200 : (max-touch.has-hover ? Theme.default-base.with-alpha(0.4) : Colors.transparent);
                        accessible-role: AccessibleRole.button;
                        accessible-label: root.maximized ? @tr("Restore") : @tr("Maximize");

                        max-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.maximized = !root.maximized;
                            }
                        }

                        Image {
                            width: 16px;
                            height: 16px;
                            source: root.maximized ? @image-url("../icons/chrome-restore.svg") : @image-url("../icons/chrome-maximize.svg");
                            colorize: Theme.foreground;
                        }
                    }

                    close-btn := Rectangle {
                        width: 35px;
                        height: 35px;
                        background: close-touch.has-hover || close-touch.pressed ? Theme.window-close-hover : Colors.transparent;
                        accessible-role: AccessibleRole.button;
                        accessible-label: @tr("Close");
                        animate background { duration: 150ms; }

                        close-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.close-clicked();
                            }
                        }

                        Image {
                            width: 16px;
                            height: 16px;
                            source: @image-url("../icons/chrome-close.svg");
                            colorize: close-touch.has-hover || close-touch.pressed ? Theme.primary-foreground : Theme.foreground;
                        }
                    }
                }
            }
        }

        tab-bar := Rectangle {
            height: 52px;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.default-200;
            }

            tab-drag := TouchArea {
                width: 100%;
                height: 100%;
                moved => {
                    if self.pressed && !root.has-dragged {
                        root.has-dragged = true;
                        root.drag();
                    }
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.has-dragged = false;
                    }
                }
                double-clicked => {
                    root.maximized = !root.maximized;
                }
            }

            HorizontalLayout {
                alignment: center;
                cross-axis-alignment: center;

                PillTabs {
                    shape: "full";
                    tabs: [
                        @tr("Translate"),
                        @tr("Services"),
                        @tr("Wordbook"),
                        @tr("About"),
                    ];
                    current <=> root.page;
                }
            }
        }

        page-area := Rectangle {
            vertical-stretch: 1;

            // 点空白处收掉输入框焦点：Slint 只在点到另一个可聚焦控件时才转移焦点，
            // 不然光标会一直留在黑名单输入框里（用户报的）。这个 FocusScope 只是个接焦点的空壳。
            blur-catcher := FocusScope {
                width: 0px;
                height: 0px;
                focus-on-tab-navigation: false;
            }

            // 放在 scroll 前面 = 画在底下，只有上面没人接的点击才落到这儿
            TouchArea {
                clicked => {
                    blur-catcher.focus();
                }
            }

            scroll := ScrollArea {
                // ScrollView 自动算的 viewport 高度用的是子布局的 min-height（编译器 passes/flickable.rs），
                // 而 SettingRow 写死 min-height: 40px，比实际行高小，算出来的 viewport 撑不到内容高度，页面就滚不动。
                // 显式绑定 preferred-height 跳过那条自动规则；页面比可视区短时取可视高度，免得 viewport 比窗口还小。
                viewport-height: max(self.visible-height, content.preferred-height);

                content := VerticalLayout {
                    padding-left: root.page == 3 ? 0px : 10px;
                    padding-right: root.page == 3 ? 0px : 10px;
                    padding-top: root.page == 3 ? 0px : 10px;
                    padding-bottom: root.page == 3 ? 0px : 10px;
                    alignment: start;

                    if root.page == 0 : TranslatePage { }

                    if root.page == 1 : ServicesPage {
                        available-height: scroll.visible-height - 20px;
                        translate-services: root.translate-services;
                        recognize-services: root.recognize-services;
                        set-service-enabled(kind, idx, enabled) => {
                            root.set-service-enabled(kind, idx, enabled);
                        }
                        remove-service(kind, idx) => {
                            root.remove-service(kind, idx);
                        }
                        move-service(kind, from, to) => {
                            root.move-service(kind, from, to);
                        }
                        add-service(kind) => {
                            root.dialog-kind = kind;
                            // 识别服务只有内置的（旧版 Recognize/index.jsx 也是一层），
                            // 不走「内置 / AI」那层选择。
                            root.dialog = kind == "recognize" ? 2 : 1;
                        }
                        edit-service(kind, idx) => {
                            root.edit-service(kind, idx);
                        }
                    }

                    if root.page == 2 : Card {
                        content-padding: 12px;
                        Text {
                            text: @tr("Wordbook");
                            font-size: 14px;
                            color: Theme.default-400;
                        }
                    }

                    if root.page == 3 : AboutPage {
                        version: root.version;
                        autostart-enabled <=> root.autostart-enabled;
                        autostart-supported: root.autostart-supported;
                        checking-update: root.checking-update;
                        credits: root.credits;
                        open-url(url) => { root.open-url(url); }
                        open-github => { root.open-github(); }
                        open-feedback => { root.open-feedback(); }
                        open-releases => { root.open-releases(); }
                        autostart-toggled(on) => { root.autostart-toggled(on); }
                        check-update => { root.check-update(); }
                        view-log => { root.view-log(); }
                        view-config => { root.view-config(); }
                    }
                }
            }
        }
    }

    ServiceDialogs {
        dialog <=> root.dialog;
        dialog-kind <=> root.dialog-kind;
        dialog-service <=> root.dialog-service;
        dialog-index <=> root.dialog-index;

        draft-label <=> root.draft-label;
        draft-google-mode-index <=> root.draft-google-mode-index;
        draft-google-custom-url <=> root.draft-google-custom-url;
        draft-google-api-key <=> root.draft-google-api-key;
        draft-google-custom-api-url <=> root.draft-google-custom-api-url;

        window-height: root.height;
        wechat-icon-color: root.wechat-icon-color;

        add-ai-service(k) => {
            root.add-ai-service(k);
        }
        save-service(kind, idx, service, label, mode, custom-url, api-key, custom-api-url) => {
            root.save-service(kind, idx, service, label, mode, custom-url, api-key, custom-api-url);
        }
    }

    // 窗口正中（用户 B2 F7 手测时定的；旧版 react-hot-toast 是 top-center top:45）
    toast := Toast {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}
