// ui.md §6.5 服务设置页：添加 / 编辑对话框链。
import { Theme } from "../common/theme.slint";
import { Modal } from "../common/modal.slint";
import { Button } from "../common/button.slint";
import { SettingRow } from "../common/card.slint";
import { Select } from "../common/select.slint";
import { TextField, TextArea } from "../common/text_field.slint";
import { ScrollArea } from "../common/scroll_area.slint";
import { LoadingDots } from "../common/loading_dots.slint";
import { ServiceIcon } from "service_icon.slint";

export struct ModelRow {
    name: string,
    state: string,   // "ms" | "testing" | "untested" | "failed"
    ms: int,
    rank: int,       // 0 = 不显示排名
}

export struct AiPreset {
    id: string,
    name: string,
    base-url: string,
    protocol: string,
    has-logo: bool,
    icon-color: brush,
    icon-letter: string,
}

export struct ServiceDraft {
    kind: string,
    real-index: int,
    service: string,
    label: string,
    google-mode: string,
    google-custom-url: string,
    google-api-key: string,
    google-custom-api-url: string,
    ai-base-url: string,
    ai-api-key: string,
    ai-model: string,
    ai-protocol: string,
    ai-custom-instructions: string,
    ai-icon: string,
    umi-url: string,
}

component BuiltinServiceItem {
    in property <image> icon;
    in property <bool> has-colorize: false;
    in property <brush> colorize;
    in property <string> title;
    in property <bool> enabled: true;

    callback clicked();

    property <bool> kb-focus: false;

    forward-focus: fs;
    height: 48px;
    accessible-role: AccessibleRole.button;
    accessible-label: root.title;

    if root.kb-focus : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-medium + 2px;
        border-width: 2px;
        border-color: Theme.focus;
    }

    bg := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-medium;
        border-width: 1px;
        border-color: Theme.default-base;
        background: touch.pressed ? Theme.default-100 : Theme.content1;

        opacity: root.enabled ? 1.0 : 0.5;
        animate background, opacity { duration: 150ms; }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            cross-axis-alignment: center;

            if !root.has-colorize : Image {
                width: 24px;
                height: 24px;
                source: root.icon;
            }

            if root.has-colorize : Image {
                width: 24px;
                height: 24px;
                source: root.icon;
                colorize: root.colorize;
            }

            Text {
                text: root.title;
                font-size: 16px;
                color: Theme.foreground;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }

    fs := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        focus-gained(reason) => {
            root.kb-focus = reason == FocusReason.tab-navigation;
        }
        focus-lost(reason) => {
            root.kb-focus = false;
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }

        touch := TouchArea {
            enabled: root.enabled;
            width: 100%;
            height: 100%;
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.clicked();
            }
        }
    }
}

component PresetGridButton {
    in property <AiPreset> preset;

    callback clicked();

    property <bool> kb-focus: false;

    forward-focus: fs;
    height: 64px;
    accessible-role: AccessibleRole.button;
    accessible-label: root.preset.name;

    if root.kb-focus : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-medium + 2px;
        border-width: 2px;
        border-color: Theme.focus;
    }

    bg := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-medium;
        border-width: 1px;
        border-color: Theme.default-base;
        background: touch.pressed ? Theme.default-100 : Theme.content1;

        opacity: touch.pressed ? (Theme.dark ? 0.8 : 0.7) : (touch.has-hover ? (Theme.dark ? 0.9 : 0.8) : 1.0);
        animate background, opacity { duration: 150ms; }

        VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 4px;
            padding-right: 4px;
            spacing: 4px;
            alignment: center;
            cross-axis-alignment: center;

            ServiceIcon {
                id: root.preset.id;
                has-logo: root.preset.has-logo;
                icon-color: root.preset.icon-color;
                icon-letter: root.preset.icon-letter;
                size: 24px;
            }

            Text {
                text: root.preset.name;
                font-size: 11px;
                color: Theme.foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                width: 100%;
            }
        }
    }

    fs := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        focus-gained(reason) => {
            root.kb-focus = reason == FocusReason.tab-navigation;
        }
        focus-lost(reason) => {
            root.kb-focus = false;
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }

        touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.clicked();
            }
        }
    }
}

component CustomAiButton {
    callback clicked();

    property <bool> kb-focus: false;

    forward-focus: fs;
    height: 56px;
    width: 100%;
    accessible-role: AccessibleRole.button;
    accessible-label: @tr("Custom");

    if root.kb-focus : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-medium + 2px;
        border-width: 2px;
        border-color: Theme.focus;
    }

    bg := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-medium;
        border-width: 1px;
        border-color: Theme.default-base;
        background: touch.pressed ? Theme.default-100 : Theme.content1;

        opacity: touch.pressed ? (Theme.dark ? 0.8 : 0.7) : (touch.has-hover ? (Theme.dark ? 0.9 : 0.8) : 1.0);
        animate background, opacity { duration: 150ms; }

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 2px;
            alignment: center;
            cross-axis-alignment: start;

            Text {
                text: @tr("Custom");
                font-size: 13px;
                color: Theme.foreground;
            }

            Text {
                text: @tr("Self-hosted proxy, OneAPI, local relay");
                font-size: 10px;
                color: Theme.default-500;
            }
        }
    }

    fs := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        focus-gained(reason) => {
            root.kb-focus = reason == FocusReason.tab-navigation;
        }
        focus-lost(reason) => {
            root.kb-focus = false;
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }

        touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.clicked();
            }
        }
    }
}

export component ServiceDialogs {
    in-out property <int> dialog: 0;
    in-out property <string> dialog-kind: "translate";
    in-out property <string> dialog-service: "google";
    in-out property <int> dialog-index: -1;

    in-out property <string> draft-label: "";
    // Select 会写自己的 `current-index`，所以草稿这边存的就是下标、双向绑上去。
    // 用 `current-index: <字符串三元>` 这种单向绑定，选一次就把绑定打断了（B2 F7 实测）。
    // 0 = web，1 = custom_api，2 = api。
    in-out property <int> draft-google-mode-index: 0;
    in-out property <string> draft-google-custom-url: "";
    in-out property <string> draft-google-api-key: "";
    in-out property <string> draft-google-custom-api-url: "";

    // AI 草稿属性
    in-out property <string> draft-ai-base-url: "";
    in-out property <string> draft-ai-api-key: "";
    in-out property <string> draft-ai-model: "";
    in-out property <int> draft-ai-protocol-index: 0;
    in-out property <string> draft-ai-custom-instructions: "";
    in-out property <string> draft-ai-icon: "";
    in-out property <bool> draft-ai-has-logo: false;
    in-out property <brush> draft-ai-icon-color: Theme.foreground;
    in-out property <string> draft-ai-icon-letter: "";

    // Umi-OCR 草稿属性
    in-out property <string> draft-umi-url: "";

    in-out property <string> resolved-chat-url: "";
    in property <[AiPreset]> ai-presets: [];
    in property <string> default-ai-custom-instructions: "";

    in property <length> window-height;
    in property <brush> wechat-icon-color;
    in property <brush> umi-icon-color;
    in property <bool> recognize-has-wechat: false;
    in property <bool> recognize-has-umi: false;
    in property <bool> testing: false;
    in property <bool> fetching: false;
    in property <[ModelRow]> ai-models: [];
    in property <bool> bench-running: false;
    in property <string> bench-current: "";
    in property <int> bench-remaining: 0;
    in property <int> bench-tested: 0;
    in property <int> bench-failed: 0;

    callback save-service(ServiceDraft);
    callback test-service(ServiceDraft);
    callback fetch-models(ServiceDraft);
    callback refresh-resolved-url(string, string, string, string);
    callback start-benchmark(ServiceDraft, bool);
    callback stop-benchmark(ServiceDraft);

    // 测试连接的结果条（旧版 `google/Config.jsx:194-204`）。组件自己写自己的**普通**属性，
    // 不是 `in-out`（U-11），值由调用方通过下面这个 public function 送进来，跟 `Toast` 同一个路子。
    property <string> test-result: "";
    property <bool> test-ok: false;
    property <bool> models-expanded: false;

    public function show-test-result(message: string, ok: bool) {
        root.test-result = message;
        root.test-ok = ok;
    }

    // 换对话框（打开、关闭、退回上一层）一律把上一次的结果丢掉
    changed dialog => {
        root.test-result = "";
        root.models-expanded = false;
    }

    function current-protocol-str() -> string {
        root.draft-ai-protocol-index == 1 ? "openai_responses" : (
            root.draft-ai-protocol-index == 2 ? "anthropic" : (
                root.draft-ai-protocol-index == 3 ? "google" : "openai_chat"
            )
        )
    }

    function current-draft() -> ServiceDraft {
        {
            kind: root.dialog-kind,
            real-index: root.dialog-index,
            service: root.dialog-service,
            label: root.draft-label,
            google-mode: root.draft-google-mode-index == 1 ? "custom_api" : (root.draft-google-mode-index == 2 ? "api" : "web"),
            google-custom-url: root.draft-google-custom-url,
            google-api-key: root.draft-google-api-key,
            google-custom-api-url: root.draft-google-custom-api-url,
            ai-base-url: root.draft-ai-base-url,
            ai-api-key: root.draft-ai-api-key,
            ai-model: root.draft-ai-model,
            ai-protocol: root.current-protocol-str(),
            ai-custom-instructions: root.draft-ai-custom-instructions,
            ai-icon: root.draft-ai-icon,
            umi-url: root.draft-umi-url,
        }
    }

    function select-preset(p: AiPreset) {
        root.draft-ai-base-url = p.base-url;
        root.draft-ai-protocol-index = (p.protocol == "openai_responses" ? 1 : (p.protocol == "anthropic" ? 2 : (p.protocol == "google" ? 3 : 0)));
        root.draft-ai-icon = p.id;
        root.draft-ai-has-logo = p.has-logo;
        root.draft-ai-icon-color = p.icon-color;
        root.draft-ai-icon-letter = p.icon-letter;
        root.draft-ai-model = "";
        root.draft-ai-api-key = "";
        root.draft-label = "";
        root.draft-ai-custom-instructions = root.default-ai-custom-instructions;
        root.dialog-service = "ai";
        root.dialog-index = -1;
        root.dialog = 3;
        root.refresh-resolved-url(p.base-url, "", p.protocol, root.draft-ai-icon);
    }

    function select-custom() {
        root.draft-ai-base-url = "";
        root.draft-ai-protocol-index = 0;
        root.draft-ai-icon = "";
        root.draft-ai-model = "";
        root.draft-ai-api-key = "";
        root.draft-label = "";
        root.draft-ai-custom-instructions = root.default-ai-custom-instructions;
        root.dialog-service = "ai";
        root.dialog-index = -1;
        root.dialog = 3;
        root.refresh-resolved-url("", "", "openai_chat", root.draft-ai-icon);
    }

    width: 100%;
    height: 100%;
    x: 0;
    y: 0;
    visible: root.dialog > 0;

    // Modal 1: 添加服务
    Modal {
        open: root.dialog == 1;
        title: @tr("Add Service");
        closed => {
            if root.dialog == 1 {
                root.dialog = 0;
            }
        }

        Button {
            text: @tr("Add Built-in Service");
            variant: "bordered";
            size: "md";
            full-width: true;
            clicked => {
                root.dialog = 2;
            }
        }

        Button {
            text: @tr("Add AI Service");
            variant: "bordered";
            size: "md";
            full-width: true;
            clicked => {
                root.dialog = 4;
            }
        }

        HorizontalLayout {
            alignment: end;

            Button {
                text: @tr("Cancel");
                variant: "light";
                color: "danger";
                size: "md";
                clicked => {
                    root.dialog = 0;
                }
            }
        }
    }

    // Modal 2: 内置服务列表
    Modal {
        open: root.dialog == 2;
        title: @tr("Add Built-in Service");
        closed => {
            if root.dialog == 2 {
                root.dialog = 0;
            }
        }

        if root.dialog-kind == "translate" : BuiltinServiceItem {
            icon: @image-url("../icons/logo/google.svg");
            has-colorize: false;
            title: @tr("Google Translate");
            clicked => {
                root.dialog-service = "google";
                root.dialog-index = -1;
                root.draft-label = "";
                root.draft-google-mode-index = 0;
                root.draft-google-custom-url = "";
                root.draft-google-api-key = "";
                root.draft-google-custom-api-url = "";
                root.dialog = 3;
            }
        }

        // 识别服务每种只装一个：装过的这里就不再出现，两个都装了只剩一句说明（旧版行为）。
        if root.dialog-kind == "recognize" && !root.recognize-has-wechat : BuiltinServiceItem {
            icon: @image-url("../icons/logo/wechat.svg");
            has-colorize: true;
            colorize: root.wechat-icon-color;
            title: @tr("WeChat OCR");
            clicked => {
                root.dialog-service = "wechat";
                root.dialog-index = -1;
                root.draft-label = "";
                root.dialog = 3;
            }
        }

        if root.dialog-kind == "recognize" && !root.recognize-has-umi : BuiltinServiceItem {
            icon: @image-url("../icons/logo/umi.svg");
            has-colorize: true;
            colorize: root.umi-icon-color;
            title: @tr("Umi-OCR");
            clicked => {
                root.dialog-service = "umi";
                root.dialog-index = -1;
                root.draft-label = "";
                root.draft-umi-url = "";
                root.dialog = 3;
            }
        }

        if root.dialog-kind == "recognize" && root.recognize-has-wechat && root.recognize-has-umi : Text {
            text: @tr("All available text recognition services are already installed");
            font-size: 14px;
            color: Theme.default-500;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: end;

            Button {
                text: @tr("Cancel");
                variant: "light";
                color: "danger";
                size: "md";
                clicked => {
                    root.dialog = 0;
                }
            }
        }
    }

    // Modal 4: AI 预设网格
    Modal {
        open: root.dialog == 4;
        title: @tr("Add AI Service");
        closed => {
            if root.dialog == 4 {
                root.dialog = 0;
            }
        }

        VerticalLayout {
            spacing: 8px;

            preset-container := Rectangle {
                property <int> cols: 3;
                property <length> col-width: (self.width - 16px) / 3;
                // `/ 3.0` 而不是 `/ 3`：万一是整数除法，10 家预设会算出 3 行，第 10 格溢出容器。
                property <int> rows: Math.ceil(root.ai-presets.length / 3.0);
                // 格子是绝对定位的，这个 Rectangle 自己没有内容高度，必须显式算。
                // 别想着再加 min-height / max-height 兜底：Slint 不许和 height 同时给。
                height: rows * 64px + Math.max(0, rows - 1) * 8px;

                for p[i] in root.ai-presets : PresetGridButton {
                    x: Math.mod(i, 3) * (preset-container.col-width + 8px);
                    y: Math.floor(i / 3) * 72px;
                    width: preset-container.col-width;
                    preset: p;
                    clicked => {
                        root.select-preset(p);
                    }
                }
            }

            CustomAiButton {
                clicked => {
                    root.select-custom();
                }
            }
        }

        HorizontalLayout {
            alignment: end;

            Button {
                text: @tr("Cancel");
                variant: "light";
                color: "danger";
                size: "md";
                clicked => {
                    root.dialog = 0;
                }
            }
        }
    }

    // Modal 3: 服务配置
    cfg-modal := Modal {
        open: root.dialog == 3;
        title: "";
        closed => {
            if root.dialog == 3 {
                root.dialog = 0;
            }
        }

        scroll := ScrollArea {
            // 高度跟表单走，长了才夹到上限并滚动。ScrollArea 的 preferred-height 是 100%，
            // 不显式给高度会把对话框撑满（B2 F7 实测）。
            // 结果条是卡片里多出来的一行（连同它上面那 12px 间距），表单要给它让出这点高度，
            // 否则卡片会顶到 Modal 的 80% 上限，底下的按钮被挤出去。
            height: min(
                form-layout.preferred-height,
                max(100px, root.window-height * 0.75 - 192px - result-box.height - 12px)
            );
            // 滚动条默认画在 ScrollArea 自己的右边缘，也就是 Modal 内容区 24px 内边距的里侧，
            // 正好压在右列控件上（旧版是贴卡片边缘的）。用负值把它推出内边距：
            // -22px = -(24px 内边距 - 2px 离边距离)；-8px 抵消内容区的 padding-top，
            // 让轨道从标题栏下沿起、滑块能顶到内容块最上面。
            track-margin: -22px;
            track-inset: -8px;
            viewport-height: max(self.visible-height, form-layout.preferred-height);

            form-layout := VerticalLayout {
                spacing: 0px;

                if root.dialog-service == "google" : VerticalLayout {
                    spacing: 0px;

                    SettingRow {
                        label: @tr("Name");
                        control-width: cfg-modal.content-width * 50%;

                        TextField {
                            width: 100%;
                            text <=> root.draft-label;
                            placeholder: @tr("Google Translate");
                        }
                    }

                    SettingRow {
                        label: @tr("Mode");
                        control-width: cfg-modal.content-width * 50%;

                        Select {
                            width: 100%;
                            options: [
                                @tr("Web Interface (Default)"),
                                @tr("Custom Proxy API"),
                                @tr("Google Cloud Official API"),
                            ];
                            current-index <=> root.draft-google-mode-index;
                        }
                    }

                    if root.draft-google-mode-index == 1 : SettingRow {
                        label: @tr("Proxy API URL");
                        control-width: cfg-modal.content-width * 50%;

                        TextField {
                            width: 100%;
                            text <=> root.draft-google-custom-api-url;
                            placeholder: "https://.../translate";
                        }
                    }

                    if root.draft-google-mode-index == 2 : SettingRow {
                        label: @tr("API Key");
                        control-width: cfg-modal.content-width * 50%;

                        TextField {
                            width: 100%;
                            password: true;
                            text <=> root.draft-google-api-key;
                        }
                    }

                    if root.draft-google-mode-index == 0 : SettingRow {
                        label: @tr("Mirror URL");
                        control-width: cfg-modal.content-width * 50%;

                        TextField {
                            width: 100%;
                            text <=> root.draft-google-custom-url;
                            placeholder: "https://translate.google.com";
                        }
                    }
                }

                if root.dialog-service == "wechat" : VerticalLayout {
                    spacing: 0px;

                    SettingRow {
                        label: @tr("Name");
                        control-width: cfg-modal.content-width * 50%;

                        TextField {
                            width: 100%;
                            text <=> root.draft-label;
                            placeholder: @tr("WeChat OCR");
                        }
                    }
                }

                if root.dialog-service == "umi" : VerticalLayout {
                    spacing: 0px;

                    SettingRow {
                        label: @tr("Name");
                        control-width: cfg-modal.content-width * 50%;

                        TextField {
                            width: 100%;
                            text <=> root.draft-label;
                            placeholder: @tr("Umi-OCR");
                        }
                    }

                    SettingRow {
                        label: @tr("Service URL");
                        control-width: cfg-modal.content-width * 50%;

                        TextField {
                            width: 100%;
                            text <=> root.draft-umi-url;
                            placeholder: "http://127.0.0.1:1224/api/ocr";
                        }
                    }

                    // 旧版把「怎么开」和「识别能力来自谁」都写在弹窗里（`Recognize/ConfigModal`），
                    // 后者是 NOTICE 里的第三方声明，照搬过来。
                    Text {
                        text: @tr("Start Umi-OCR first and enable its HTTP service under Global Settings, default port 1224. Offline recognition is provided by the open-source project hiroi-sora/Umi-OCR.");
                        font-size: 12px;
                        color: Theme.default-400;
                        wrap: word-wrap;
                    }
                }

                if root.dialog-service == "ai" : VerticalLayout {
                    spacing: 0px;

                    SettingRow {
                        label: @tr("Icon");
                        control-width: cfg-modal.content-width * 50%;

                        HorizontalLayout {
                            alignment: start;
                            cross-axis-alignment: center;

                            ServiceIcon {
                                id: root.draft-ai-icon;
                                has-logo: root.draft-ai-has-logo;
                                icon-color: root.draft-ai-icon-color;
                                icon-letter: root.draft-ai-icon-letter;
                                size: 24px;
                            }
                        }
                    }

                    SettingRow {
                        label: @tr("Name");
                        control-width: cfg-modal.content-width * 50%;

                        TextField {
                            width: 100%;
                            text <=> root.draft-label;
                            placeholder: @tr("AI Translation");
                        }
                    }

                    SettingRow {
                        label: @tr("Request Path");
                        control-width: cfg-modal.content-width * 50%;

                        TextField {
                            width: 100%;
                            text <=> root.draft-ai-base-url;
                            placeholder: "https://api.example.com/v1";
                            edited(text) => {
                                root.refresh-resolved-url(
                                    text,
                                    root.draft-ai-model,
                                    root.current-protocol-str(),
                                    root.draft-ai-icon
                                );
                            }
                        }
                    }

                    if root.resolved-chat-url != "" : HorizontalLayout {
                        alignment: end;
                        padding-bottom: 6px;

                        Text {
                            text: root.resolved-chat-url;
                            font-size: 11px;
                            color: Theme.default-400;
                            horizontal-alignment: right;
                            wrap: word-wrap;
                        }
                    }

                    SettingRow {
                        label: @tr("API Key");
                        control-width: cfg-modal.content-width * 50%;

                        TextField {
                            width: 100%;
                            password: true;
                            text <=> root.draft-ai-api-key;
                        }
                    }

                    SettingRow {
                        label: @tr("API Format");
                        control-width: cfg-modal.content-width * 50%;

                        Select {
                            width: 100%;
                            options: [
                                @tr("OpenAI Chat Completions"),
                                @tr("OpenAI Responses"),
                                @tr("Anthropic"),
                                @tr("Google"),
                            ];
                            current-index <=> root.draft-ai-protocol-index;
                            selected(idx) => {
                                root.refresh-resolved-url(
                                    root.draft-ai-base-url,
                                    root.draft-ai-model,
                                    idx == 1 ? "openai_responses" : (idx == 2 ? "anthropic" : (idx == 3 ? "google" : "openai_chat")),
                                    root.draft-ai-icon
                                );
                            }
                        }
                    }

                    SettingRow {
                        label: @tr("Model");
                        control-width: cfg-modal.content-width * 50%;

                        HorizontalLayout {
                            property <length> ctl: cfg-modal.content-width * 50%;
                            spacing: 8px;

                            TextField {
                                width: parent.ctl - 48px;
                                text <=> root.draft-ai-model;
                                edited(text) => {
                                    root.refresh-resolved-url(
                                        root.draft-ai-base-url,
                                        text,
                                        root.current-protocol-str(),
                                        root.draft-ai-icon
                                    );
                                }
                            }

                            Button {
                                icon-only: true;
                                variant: "bordered";
                                size: "md";
                                icon: @image-url("../icons/refresh.svg");
                                loading: root.fetching;
                                clicked => {
                                    root.test-result = "";
                                    root.fetch-models(root.current-draft());
                                }
                            }
                        }
                    }

                    models-panel := Rectangle {
                        border-width: 1px;
                        border-color: Theme.default-200;
                        border-radius: Theme.radius-medium;
                        clip: true;
                        // U-10：高度显式跟内容走。收起时**整段列表不实例化** —— 留在布局里
                        // （哪怕 visible: false）会跟 40px 的标题行抢这点高度，把标题挤扁
                        // （B2 F7 第 14 轮手测实拍）。
                        height: panel-layout.preferred-height;

                        panel-layout := VerticalLayout {
                            padding: 0px;
                            spacing: 0px;

                            header := Rectangle {
                                height: 40px;
                                background: header-touch.has-hover ? Theme.default-100 : Theme.default-100.with-alpha(0);
                                animate background { duration: 150ms; }

                                header-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.models-expanded = !root.models-expanded;
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;
                                    cross-axis-alignment: center;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        cross-axis-alignment: center;

                                        Text {
                                            text: @tr("Model Speed Test");
                                            font-size: 13px;
                                            color: Theme.foreground;
                                            vertical-alignment: center;
                                        }

                                        if root.bench-running : HorizontalLayout {
                                            spacing: 4px;
                                            cross-axis-alignment: center;

                                            // 三点自己没有固有尺寸（内部是 `for`，不参与布局信息，§3 第 17 条），
                                            // 横排里 cross-axis-alignment: center 拿 preferred 会压成 0 —— 必须给死尺寸。
                                            LoadingDots { width: 16px; height: 4px; }

                                            Text {
                                                text: root.bench-current != "" ? root.bench-current : @tr("Testing...");
                                                font-size: 11px;
                                                color: Theme.primary;
                                                vertical-alignment: center;
                                            }
                                        }

                                        if !root.bench-running && root.bench-tested > 0 : Text {
                                            text: root.bench-failed > 0
                                                ? @tr("({}/{} available, {} failed)", root.bench-tested, root.ai-models.length, root.bench-failed)
                                                : @tr("({}/{} available)", root.bench-tested, root.ai-models.length);
                                            font-size: 11px;
                                            color: Theme.default-400;
                                            vertical-alignment: center;
                                        }

                                        if !root.bench-running && root.bench-tested == 0 : Text {
                                            text: "(" + root.ai-models.length + ")";
                                            font-size: 11px;
                                            color: Theme.default-400;
                                            vertical-alignment: center;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        cross-axis-alignment: center;

                                        Text {
                                            text: root.models-expanded ? @tr("Collapse") : @tr("Expand");
                                            font-size: 11px;
                                            color: Theme.default-400;
                                            vertical-alignment: center;
                                        }

                                        Image {
                                            width: 14px;
                                            height: 14px;
                                            source: @image-url("../icons/chevron-down.svg");
                                            colorize: Theme.default-400;
                                            transform-rotation: root.models-expanded ? 180deg : 0deg;
                                            animate transform-rotation { duration: 150ms; easing: ease-out; }
                                        }
                                    }
                                }
                            }

                            if root.models-expanded : VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-bottom: 10px;
                                padding-top: 4px;
                                spacing: 6px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    cross-axis-alignment: center;
                                    spacing: 8px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        cross-axis-alignment: center;
                                        horizontal-stretch: 1;

                                        if root.bench-running : Button {
                                            size: "sm";
                                            variant: "light";
                                            color: "danger";
                                            icon: @image-url("../icons/square.svg");
                                            text: @tr("Stop");
                                            clicked => { root.stop-benchmark(root.current-draft()); }
                                        }
                                        if !root.bench-running : Button {
                                            size: "sm";
                                            variant: "light";
                                            color: "primary";
                                            icon: @image-url("../icons/play-arrow.svg");
                                            text: root.bench-tested > 0 ? @tr("Retest all") : @tr("Start speed test");
                                            enabled: root.ai-models.length > 0;
                                            clicked => {
                                                root.test-result = "";
                                                root.start-benchmark(root.current-draft(), root.bench-tested > 0);
                                            }
                                        }

                                        // U-12：`alignment: space-between` 不分剩余空间，孩子一律按 preferred 摆，
                                        // 说明文字够长就会把右边的「剩余 N」顶出 clip 之外。用已知定宽自己算，
                                        // 剩下的 230px 留给按钮和剩余数。
                                        Text {
                                            width: cfg-modal.content-width - 230px;
                                            text: @tr("Sequential probe, fastest first");
                                            font-size: 11px;
                                            color: Theme.default-400;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if root.bench-running : Text {
                                        text: @tr("{} left", root.bench-remaining);
                                        font-size: 11px;
                                        color: Theme.primary;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: Theme.default-200;
                                }

                                if root.ai-models.length == 0 : Rectangle {
                                    height: 36px;

                                    Text {
                                        text: @tr("Click refresh to load the model list");
                                        font-size: 12px;
                                        color: Theme.default-400;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                for m in root.ai-models : Rectangle {
                                    height: 32px;
                                    border-radius: Theme.radius-small;
                                    border-width: 1px;
                                    border-color: m.name == root.draft-ai-model
                                        ? Theme.primary.with-alpha(0.5)
                                        : Theme.default-200;
                                    background: m.name == root.draft-ai-model
                                        ? Theme.primary.with-alpha(0.1)
                                        : Colors.transparent;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        cross-axis-alignment: center;

                                        Rectangle {
                                            width: 32px;
                                            // U-10：非布局元素不会被子元素撑开，横排里又是按 preferred 居中，
                                            // 不写死高度会塌成 0，里面按 parent.height 算的 y 会跑到行外。
                                            height: 32px;

                                            if m.state == "ms" : Text {
                                                width: 100%;
                                                height: 100%;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                text: "#" + m.rank;
                                                font-size: 11px;
                                                color: Theme.default-500;
                                            }
                                            if m.state == "testing" : HorizontalLayout {
                                                alignment: center;
                                                cross-axis-alignment: center;
                                                LoadingDots { width: 16px; height: 4px; }
                                            }
                                            if m.state == "failed" : Image {
                                                width: 12px;
                                                height: 12px;
                                                source: @image-url("../icons/x.svg");
                                                colorize: Theme.danger;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            if m.state != "ms" && m.state != "testing" && m.state != "failed" : Text {
                                                width: 100%;
                                                height: 100%;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                text: "-";
                                                font-size: 11px;
                                                color: Theme.default-300;
                                            }
                                        }

                                        Text {
                                            text: m.name;
                                            font-size: 12px;
                                            color: Theme.foreground;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            width: 64px;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            font-size: 11px;
                                            text: m.state == "ms" ? (m.ms + "ms") :
                                                  m.state == "testing" ? @tr("Testing...") :
                                                  m.state == "failed" ? @tr("Unavailable") :
                                                  @tr("Untested");
                                            color: m.state == "ms" ? (
                                                m.ms < 350 ? Theme.success :
                                                m.ms < 800 ? Theme.primary :
                                                m.ms < 1500 ? Theme.warning :
                                                Theme.danger
                                            ) :
                                            m.state == "testing" ? Theme.primary :
                                            m.state == "failed" ? Theme.danger :
                                            Theme.default-400;
                                        }

                                        Button {
                                            size: "sm";
                                            variant: m.name == root.draft-ai-model ? "solid" : "bordered";
                                            color: "primary";
                                            text: m.name == root.draft-ai-model ? @tr("In use") : @tr("Use");
                                            enabled: m.name != root.draft-ai-model && m.state != "failed";
                                            clicked => {
                                                root.draft-ai-model = m.name;
                                                root.refresh-resolved-url(
                                                    root.draft-ai-base-url,
                                                    m.name,
                                                    root.current-protocol-str(),
                                                    root.draft-ai-icon
                                                );
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 8px;

                        Text {
                            text: @tr("Custom Instructions");
                            font-size: 14px;
                            color: Theme.foreground;
                        }

                        TextArea {
                            text <=> root.draft-ai-custom-instructions;
                        }
                    }
                }
            }
        }

        // 测试结果条。空的时候高 0（Slint 里 `visible: false` 照样占位，要自己把高度归零）。
        result-box := Rectangle {
            height: root.test-result == "" ? 0px : result-layout.preferred-height;
            visible: root.test-result != "";
            background: root.test-ok
                ? Theme.success.with-alpha(0.12)
                : Theme.danger.with-alpha(0.12);
            border-width: root.test-result == "" ? 0px : 1px;
            border-color: root.test-ok
                ? Theme.success.with-alpha(0.4)
                : Theme.danger.with-alpha(0.4);
            border-radius: Theme.radius-medium;

            result-layout := VerticalLayout {
                padding: 12px;

                Text {
                    text: root.test-result;
                    font-size: 12px;
                    // 亮色下原色太亮，压暗一档才看得清（旧版是 success-700 / danger-700）
                    color: root.test-ok
                        ? (Theme.dark ? Theme.success : Theme.success.darker(0.35))
                        : (Theme.dark ? Theme.danger.brighter(0.3) : Theme.danger);
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;

            // 平分宽度（ui.md §6.5）：两个按钮的文字长度不同，preferred-width 就不同，
            // 光给 horizontal-stretch 只会平分**剩余**空间（§3.15），测试那个会宽一截。
            // 按 U-12 用外层已知的定宽自己算。
            property <length> half: (cfg-modal.content-width - 8px) / 2;

            Button {
                width: parent.half;
                text: @tr("Test Connection");
                variant: "bordered";
                size: "md";
                loading: root.testing;
                clicked => {
                    root.test-result = "";
                    root.test-service(root.current-draft());
                }
            }

            Button {
                width: parent.half;
                text: @tr("Save");
                variant: "solid";
                color: "primary";
                size: "md";
                enabled: !root.testing;
                clicked => {
                    root.save-service(root.current-draft());
                }
            }
        }

        HorizontalLayout {
            alignment: end;

            Button {
                text: @tr("Cancel");
                variant: "light";
                color: "danger";
                size: "md";
                clicked => {
                    root.dialog = 0;
                }
            }
        }
    }
}
