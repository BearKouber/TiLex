import { EntryBody, EntryView } from "common/entry_view.slint";
import { Theme } from "common/theme.slint";
import { Palette, ScrollView, Spinner } from "std-widgets.slint";

export struct ResultRow {
    service-id: string,
    kind: string,
    label: string,
    collapsed: bool,
    loading: bool,
    text: string,
    error: string,
    display: EntryView,
}

// 20×20 热区的图标按钮：常显，平时淡色、悬停变深，active 时换 active-icon / active-color。
component IconButton {
    in property <image> icon;
    in property <image> active-icon: root.icon;
    in property <bool> active;
    in property <color> active-color;
    in property <string> label;
    callback clicked();

    width: 20px;
    height: 20px;

    touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.label;
        clicked => {
            root.clicked();
        }
    }

    Image {
        source: root.active ? root.active-icon : root.icon;
        colorize: root.active ? root.active-color : (touch.has-hover ? Theme.text-primary : Theme.text-muted);
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

export component PopResult inherits Window {
    title: "TiLex PopResult";
    no-frame: true;
    always-on-top: true;
    width: 320px; // 与 logic::placement::RESULT_WIDTH 一致
    background: Theme.window-bg;
    forward-focus: focus-scope;

    in-out property <ColorScheme> color-scheme <=> Palette.color-scheme;
    in property <string> source-text;
    in property <bool> is-pinned;
    in property <[ResultRow]> rows;
    in property <string> lang-badge: "";
    in property <int> speaking-key: -2;
    in property <int> copied-key: -2;
    in property <int> saved-row: -1;

    callback close-requested();
    callback pin-toggled();
    callback drag-started();
    callback dragged(length, length);
    callback toggle-collapse(int);
    callback speak-clicked(int);
    callback copy-clicked(int);
    callback save-clicked(int);

    out property <length> content-height: header.height + 1px + rows-layout.preferred-height;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-requested();
                return accept;
            }
            reject
        }

        content-layout := VerticalLayout {
            // Header
            header := Rectangle {
                height: 28px;
                background: Theme.header-bg;

                header-drag := TouchArea {
                    moved => {
                        if self.pressed {
                            root.dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            root.drag-started();
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 4px;
                    alignment: space-between;

                    // Close corner (20x20 hit area)
                    close-box := Rectangle {
                        width: 20px;
                        height: 20px;

                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.close-requested();
                            }
                        }

                        Image {
                            source: @image-url("icons/x.svg");
                            colorize: close-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                            width: 12px;
                            height: 12px;
                            x: 4px;
                            y: 4px;
                        }
                    }

                    // Language badge (12px, accent, only when not empty)
                    if root.lang-badge != "" : Text {
                        text: root.lang-badge;
                        color: Theme.accent;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    // Source text
                    Text {
                        text: root.source-text;
                        overflow: elide;
                        color: Theme.text-primary;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    // Source actions: Speak & Copy (only when source-text != "")
                    if root.source-text != "" : HorizontalLayout {
                        spacing: 2px;

                        IconButton {
                            icon: @image-url("icons/volume-2.svg");
                            active-icon: @image-url("icons/square.svg");
                            active: root.speaking-key == -1;
                            active-color: Theme.accent;
                            label: self.active ? @tr("Stop") : @tr("Speak");
                            clicked => {
                                root.speak-clicked(-1);
                            }
                        }

                        IconButton {
                            icon: @image-url("icons/copy.svg");
                            active-icon: @image-url("icons/check.svg");
                            active: root.copied-key == -1;
                            active-color: Theme.success;
                            label: @tr("Copy");
                            clicked => {
                                root.copy-clicked(-1);
                            }
                        }
                    }

                    // Pin button
                    pin-box := Rectangle {
                        width: 20px;
                        height: 20px;

                        pin-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.pin-toggled();
                            }
                        }

                        Image {
                            source: @image-url("icons/pin.svg");
                            colorize: root.is-pinned ? Theme.accent : (pin-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                            width: 13px;
                            height: 13px;
                            x: 3.5px;
                            y: 3.5px;
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            // Scrollable content
            ScrollView {
                rows-layout := VerticalLayout {
                    padding: 4px;
                    spacing: 4px;

                    for row[idx] in root.rows : VerticalLayout {
                        spacing: 2px;

                        // Service header
                        row-header := Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: row-touch.has-hover ? Theme.hover-bg : Colors.transparent;

                            row-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.toggle-collapse(idx);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 4px;

                                // 折叠箭头（左）
                                Image {
                                    source: row.collapsed ? @image-url("icons/chevron-right.svg") : @image-url("icons/chevron-down.svg");
                                    colorize: Theme.text-secondary;
                                    width: 14px;
                                    height: 14px;
                                    vertical-alignment: center;
                                }

                                // 服务名
                                Text {
                                    text: row.label != "" ? row.label : (row.kind == "google" ? @tr("Google") : (row.kind == "ai" ? @tr("AI") : row.service-id));
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                // 弹性空白
                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                // 朗读、复制、收藏（右）
                                if !row.loading && row.error == "" && row.text != "" : HorizontalLayout {
                                    spacing: 2px;

                                    IconButton {
                                        icon: @image-url("icons/volume-2.svg");
                                        active-icon: @image-url("icons/square.svg");
                                        active: root.speaking-key == idx;
                                        active-color: Theme.accent;
                                        label: self.active ? @tr("Stop") : @tr("Speak");
                                        clicked => {
                                            root.speak-clicked(idx);
                                        }
                                    }

                                    IconButton {
                                        icon: @image-url("icons/copy.svg");
                                        active-icon: @image-url("icons/check.svg");
                                        active: root.copied-key == idx;
                                        active-color: Theme.success;
                                        label: @tr("Copy");
                                        clicked => {
                                            root.copy-clicked(idx);
                                        }
                                    }

                                    IconButton {
                                        icon: @image-url("icons/star.svg");
                                        active: root.saved-row == idx;
                                        active-color: Theme.gold;
                                        label: @tr("Add to wordbook");
                                        clicked => {
                                            root.save-clicked(idx);
                                        }
                                    }
                                }
                            }
                        }

                        // Service result / status
                        if !row.collapsed : Rectangle {
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 2px;
                                padding-bottom: 6px;

                                if row.loading : HorizontalLayout {
                                    spacing: 6px;
                                    Spinner {
                                        indeterminate: true;
                                        width: 14px;
                                        height: 14px;
                                    }
                                    Text {
                                        text: @tr("Translating…");
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }

                                if !row.loading && row.error != "" : Text {
                                    text: row.error;
                                    color: Theme.error;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                if !row.loading && row.error == "" : EntryBody {
                                    entry: row.display;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
