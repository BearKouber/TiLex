import { EntryBody, EntryView } from "common/entry_view.slint";
import { LoadingDots } from "common/loading_dots.slint";
import { Theme } from "common/theme.slint";
import { Palette, ScrollView } from "std-widgets.slint";

export struct ResultRow {
    service-id: string,
    kind: string,
    label: string,
    collapsed: bool,
    loading: bool,
    text: string,
    error: string,
    display: EntryView,
}

// 16×16 热区、12px 图标的按钮：平时淡色、悬停变深，active 时换 active-icon / active-color。
component IconButton {
    in property <image> icon;
    in property <image> active-icon: root.icon;
    in property <bool> active;
    in property <color> active-color;
    in property <string> label;
    in property <bool> reveal: true;
    callback clicked();

    width: 16px;
    height: 16px;
    opacity: (root.reveal || root.active || touch.has-hover) ? 1 : 0;

    touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.label;
        clicked => {
            root.clicked();
        }
    }

    Image {
        source: root.active ? root.active-icon : root.icon;
        colorize: root.active ? root.active-color : (touch.has-hover ? Theme.icon-muted-hover : Theme.icon-muted);
        width: 12px;
        height: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

export component PopResult inherits Window {
    title: "TiLex PopResult";
    no-frame: true;
    always-on-top: true;
    width: 320px; // 与 logic::placement::RESULT_WIDTH 一致
    background: Theme.content1;
    forward-focus: focus-scope;

    in-out property <ColorScheme> color-scheme <=> Palette.color-scheme;
    in property <string> source-text;
    in property <bool> is-pinned;
    in property <[ResultRow]> rows;
    in property <string> lang-badge: "";
    in property <int> speaking-key: -2;
    in property <int> copied-key: -2;
    in property <int> saved-row: -1;
    // 鼠标在浮窗里移动超过 24px 后为真（Rust 按 winit 光标事件算，每次显示复位），之后左上角红三角才生效。
    in property <bool> close-armed;

    callback close-requested();
    callback pin-toggled();
    callback drag-started();
    callback dragged(length, length);
    callback toggle-collapse(int);
    callback speak-clicked(int);
    callback copy-clicked(int);
    callback save-clicked(int);
    callback content-height-changed();

    out property <length> content-height: header.height + rows-layout.preferred-height;

    changed content-height => {
        root.content-height-changed();
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-requested();
                return accept;
            }
            reject
        }

        content-layout := VerticalLayout {
            // Header
            header := Rectangle {
                height: 24px;
                background: Theme.content1;

                header-drag := TouchArea {
                    moved => {
                        if self.pressed {
                            root.dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            root.drag-started();
                        }
                    }

                    // 布局默认 stretch 会把定高的按钮顶到上沿，要显式居中。
                    // 右边距 6 + 按钮热区内 2 = 图标离右边 8（旧版 px-[8px]），服务行同理
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 6px;
                        spacing: 4px;
                        cross-axis-alignment: center;

                        // 语种徽标：主题色六成透明度、不加粗（旧版 text-primary/60）
                        if root.lang-badge != "" : Text {
                            text: root.lang-badge;
                            color: Theme.primary.with-alpha(0.6);
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        // 原文：11px 淡灰（旧版顶栏 text-[11px] text-default-400）
                        Text {
                            text: root.source-text;
                            wrap: no-wrap;
                            overflow: elide;
                            color: Theme.default-400;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        // 右侧按钮挨着排：16px 热区里 12px 图标，间距 0 时图标之间正好 4px（旧版 gap-[4px]）
                        HorizontalLayout {
                            if root.source-text != "" : IconButton {
                                icon: @image-url("icons/volume-2.svg");
                                active-icon: @image-url("icons/square.svg");
                                active: root.speaking-key == -1;
                                active-color: Theme.icon-active;
                                label: self.active ? @tr("Stop") : @tr("Speak");
                                reveal: header-drag.has-hover;
                                clicked => {
                                    root.speak-clicked(-1);
                                }
                            }

                            if root.source-text != "" : IconButton {
                                icon: @image-url("icons/copy.svg");
                                active-icon: @image-url("icons/check.svg");
                                active: root.copied-key == -1;
                                active-color: Theme.icon-done;
                                label: @tr("Copy");
                                reveal: header-drag.has-hover;
                                clicked => {
                                    root.copy-clicked(-1);
                                }
                            }

                            // 钉子：常显，旧版的斜钉子，钉住实心。和服务行按钮同一个 IconButton，列才对得齐
                            IconButton {
                                icon: @image-url("icons/pin-angle.svg");
                                active-icon: @image-url("icons/pin-angle-fill.svg");
                                active: root.is-pinned;
                                active-color: Theme.icon-active;
                                label: self.active ? @tr("Unpin") : @tr("Pin");
                                clicked => {
                                    root.pin-toggled();
                                }
                            }
                        }
                    }
                }
            }

            // Scrollable content
            ScrollView {
                rows-layout := VerticalLayout {
                    padding-bottom: 4px;
                    spacing: 4px;

                    for row[idx] in root.rows : VerticalLayout {
                        spacing: 2px;

                        // Service header
                        row-header := Rectangle {
                            height: 20px;

                            row-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.toggle-collapse(idx);
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 6px;
                                    spacing: 2px;
                                    cross-axis-alignment: center;

                                    // 折叠箭头（左）
                                    Image {
                                        source: row.collapsed ? @image-url("icons/chevron-right.svg") : @image-url("icons/chevron-down.svg");
                                        colorize: Theme.icon-muted;
                                        width: 12px;
                                        height: 12px;
                                    }

                                    // 服务名
                                    Text {
                                        text: row.label != "" ? row.label : (row.kind == "google" ? @tr("Google") : (row.kind == "ai" ? @tr("AI") : row.service-id));
                                        color: Theme.default-400;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }

                                    // 弹性空白
                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }

                                    // 朗读、复制、收藏（右）
                                    if !row.loading && row.error == "" && row.text != "" : HorizontalLayout {
                                        IconButton {
                                            icon: @image-url("icons/volume-2.svg");
                                            active-icon: @image-url("icons/square.svg");
                                            active: root.speaking-key == idx;
                                            active-color: Theme.icon-active;
                                            label: self.active ? @tr("Stop") : @tr("Speak");
                                            reveal: row-touch.has-hover;
                                            clicked => {
                                                root.speak-clicked(idx);
                                            }
                                        }

                                        IconButton {
                                            icon: @image-url("icons/copy.svg");
                                            active-icon: @image-url("icons/check.svg");
                                            active: root.copied-key == idx;
                                            active-color: Theme.icon-done;
                                            label: @tr("Copy");
                                            reveal: row-touch.has-hover;
                                            clicked => {
                                                root.copy-clicked(idx);
                                            }
                                        }

                                        IconButton {
                                            icon: @image-url("icons/star.svg");
                                            active-icon: @image-url("icons/check.svg");
                                            active: root.saved-row == idx;
                                            active-color: Theme.icon-done;
                                            label: self.active ? @tr("Saved to wordbook") : @tr("Add to wordbook");
                                            reveal: row-touch.has-hover;
                                            clicked => {
                                                root.save-clicked(idx);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Service result / status
                        if !row.collapsed : Rectangle {
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 2px;
                                padding-bottom: 6px;

                                if row.loading : LoadingDots { }

                                if !row.loading && row.error != "" : Text {
                                    text: row.error;
                                    color: Theme.danger;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                if !row.loading && row.error == "" : EntryBody {
                                    entry: row.display;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 左上角红三角（旧版 PopResult:328-343）：close-armed 之后，悬停或点击即关闭。放在最后才盖在顶栏上面。
    corner := TouchArea {
        x: 0;
        y: 0;
        width: 10px;
        height: 10px;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: @tr("Close");
        changed has-hover => {
            if self.has-hover && root.close-armed {
                root.close-requested();
            }
        }
        clicked => {
            if root.close-armed {
                root.close-requested();
            }
        }

        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M0 0 L10 0 L0 10 Z";
            fill: corner.has-hover ? Theme.danger.darker(0.2) : Theme.danger;
        }
    }
}
