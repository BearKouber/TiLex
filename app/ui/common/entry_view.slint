import { Theme } from "theme.slint";

export struct EntryExplain {
    part: string,
    text: string,
}

export struct EntryExample {
    text: string,
    translation: string,
}

export struct EntryVocab {
    word: string,
    meaning: string,
}

export struct EntryView {
    pronunciations: string,
    translation: string,
    explanations: [EntryExplain],
    associations: string,
    examples: [EntryExample],
    notes: [string],
    main-clause: string,
    clauses: string,
    nuance: string,
    vocabulary: [EntryVocab],
}

export component EntryBody {
    in property <EntryView> entry;
    // 紧凑版 = 划词结果窗（320px 宽），对应旧版 `TranslationResult` 的 `compact` 分支：
    // text-[13px] gap-[2px]、标题 11px、词性 10px。
    // 非紧凑 = 生词本右卡，对应旧版默认分支：text-[14px] gap-[8px]、标题 12px、词性 12px。
    // Slint 的 `Text` 没有 line-height，旧版的 `leading-relaxed` 只能靠这些间距补回来。
    in property <bool> compact: false;

    property <length> body-size: root.compact ? 13px : 14px;
    property <length> muted-size: root.compact ? 11px : 12px;
    property <length> part-size: root.compact ? 10px : 12px;
    property <length> gap: root.compact ? 2px : 8px;
    // 小节之间旧版是 mt-[6px] / mt-[16px]，这里拆成外层 gap + 小节自己的 padding-top
    property <length> section-gap: root.compact ? 4px : 8px;

    VerticalLayout {
        spacing: root.gap;

        // 1. 音标：次要色
        if root.entry.pronunciations != "" : Text {
            text: root.entry.pronunciations;
            font-size: root.muted-size;
            color: Theme.default-500;
            wrap: word-wrap;
        }

        // 2. 主译文：主文字色
        if root.entry.translation != "" : Text {
            text: root.entry.translation;
            font-size: root.body-size;
            color: Theme.foreground;
            wrap: word-wrap;
        }

        // 3. 释义：每条一行，词性（淡色，有才显示）+ 释义文字
        if root.entry.explanations.length > 0 : VerticalLayout {
            spacing: root.gap;
            for item in root.entry.explanations : HorizontalLayout {
                spacing: 6px;
                // 词性和释义字号不同，布局只能顶对齐；按字体 ascent 下移，让两者基线对齐
                if item.part != "" : Rectangle {
                    width: part.preferred-width;
                    part := Text {
                        x: 0;
                        y: meaning.font-metrics.ascent - self.font-metrics.ascent;
                        width: self.preferred-width;
                        height: self.preferred-height;
                        text: item.part;
                        font-size: root.part-size;
                        color: Theme.default-400;
                    }
                }
                meaning := Text {
                    text: item.text;
                    font-size: root.body-size;
                    color: Theme.foreground;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }

        // 4. 联想词：次要色
        if root.entry.associations != "" : Text {
            text: root.entry.associations;
            font-size: root.muted-size;
            color: Theme.default-500;
            wrap: word-wrap;
        }

        // 5. 例句：标题 @tr("Examples")；每条原句 + 译句（次要色）
        // 标题不加粗到 600：旧版是 `font-medium`（500）+ default-500 的浅灰，靠颜色区分而不是靠墨量
        if root.entry.examples.length > 0 : VerticalLayout {
            padding-top: root.section-gap;
            spacing: root.section-gap;
            Text {
                text: @tr("Examples");
                font-size: root.muted-size;
                font-weight: 500;
                color: Theme.default-500;
            }
            for example in root.entry.examples : VerticalLayout {
                spacing: 2px;
                if example.text != "" : Text {
                    text: example.text;
                    font-size: root.body-size;
                    color: Theme.foreground;
                    wrap: word-wrap;
                }
                if example.translation != "" : Text {
                    text: example.translation;
                    font-size: root.body-size;
                    color: Theme.default-500;
                    wrap: word-wrap;
                }
            }
        }

        // 6. 用法与语法：小标题 + 每条一段
        if root.entry.notes.length > 0 : VerticalLayout {
            padding-top: root.section-gap;
            spacing: root.section-gap;
            Text {
                // 旧版这一栏叫「用法与语法」（`i18n/locales/*.json` 的 `translate.notes`），不是「备注」
                text: @tr("Usage and grammar");
                font-size: root.muted-size;
                font-weight: 500;
                color: Theme.default-500;
            }
            for note in root.entry.notes : Text {
                text: note;
                font-size: root.body-size;
                color: Theme.foreground;
                wrap: word-wrap;
            }
        }

        // 7. 长难句结构：主干，从句修饰用次要色
        if root.entry.main-clause != "" || root.entry.clauses != "" : VerticalLayout {
            padding-top: root.section-gap;
            spacing: root.gap;
            if root.entry.main-clause != "" : Text {
                text: root.entry.main-clause;
                font-size: root.body-size;
                color: Theme.foreground;
                wrap: word-wrap;
            }
            if root.entry.clauses != "" : Text {
                text: root.entry.clauses;
                font-size: root.body-size;
                color: Theme.default-500;
                wrap: word-wrap;
            }
        }

        // 8. 语气说明
        if root.entry.nuance != "" : Text {
            text: root.entry.nuance;
            font-size: root.body-size;
            color: Theme.foreground;
            wrap: word-wrap;
        }

        // 9. 关键词：每条一行，词 + 空格 + 含义（次要色）。旧版这里是 `font-normal`，不加粗
        if root.entry.vocabulary.length > 0 : VerticalLayout {
            padding-top: root.section-gap;
            spacing: root.gap;
            for item in root.entry.vocabulary : HorizontalLayout {
                spacing: 4px;
                Text {
                    text: item.word;
                    font-size: root.body-size;
                    color: Theme.foreground;
                }
                if item.meaning != "" : Text {
                    text: item.meaning;
                    font-size: root.body-size;
                    color: Theme.default-500;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
