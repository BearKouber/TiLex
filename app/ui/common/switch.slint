// ui.md §5.3 Switch（旧版 NextUI Switch / Toggle）
import { Theme } from "theme.slint";

export component Switch {
    // 尺寸档位："sm"（40×24，服务列表）或 "md"（48×28，开机自启）
    in property <string> size: "md";
    // 开关状态
    in-out property <bool> checked: false;
    // 是否启用：禁用时透明度 0.5，不可交互
    in property <bool> enabled: true;

    // 用户切换状态后触发，传递切换后的新状态
    callback toggled(bool);

    private property <bool> is-sm: root.size == "sm";
    private property <length> track-width: is-sm ? 40px : 48px;
    private property <length> track-height: is-sm ? 24px : 28px;
    private property <length> thumb-size: is-sm ? 16px : 20px;
    private property <length> thumb-padding: 4px;
    private property <length> thumb-x: root.checked ? (root.track-width - root.thumb-padding - root.thumb-size) : root.thumb-padding;
    private property <length> thumb-y: (root.track-height - root.thumb-size) / 2;
    private property <bool> kb-focus: false;

    public function toggle() {
        if !root.enabled {
            return;
        }
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    width: root.track-width;
    height: root.track-height;
    opacity: root.enabled ? 1.0 : 0.5;
    animate opacity { duration: 150ms; }

    accessible-role: switch;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.toggle(); }

    fs := FocusScope {
        enabled: root.enabled;
        width: 100%;
        height: 100%;

        focus-gained(reason) => {
            root.kb-focus = reason == FocusReason.tab-navigation;
        }
        focus-lost(reason) => {
            root.kb-focus = false;
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.toggle();
                return accept;
            }
            reject
        }

        touch := TouchArea {
            enabled: root.enabled;
            width: 100%;
            height: 100%;
            mouse-cursor: root.enabled ? pointer : default;

            clicked => {
                root.toggle();
            }

            track := Rectangle {
                width: root.track-width;
                height: root.track-height;
                border-radius: root.track-height / 2;
                background: root.checked ? Theme.primary : Theme.default-200;
                animate background { duration: 150ms; }

                thumb := Rectangle {
                    x: root.thumb-x;
                    y: root.thumb-y;
                    width: root.thumb-size;
                    height: root.thumb-size;
                    border-radius: root.thumb-size / 2;
                    background: Theme.primary-foreground;
                    border-width: 1px;
                    border-color: Theme.default-200;
                    animate x { duration: 200ms; }
                }
            }
        }
    }

    if root.kb-focus : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: (root.track-height / 2) + 2px;
        border-width: 2px;
        border-color: Theme.focus;
    }
}
