// ui.md §5.11 Tooltip。旧版 NextUI Tooltip（悬停 500ms 后出现，鼠标离开立即消失）。
// 采用候选 B（内嵌高 z 轴层），不抢鼠标事件与键盘焦点，避免 PopupWindow 的点击吞噬与闪烁。
import { Theme } from "theme.slint";

export component Tooltip {
    // 提示文本
    in property <string> text: "";
    // 显示方位："top" | "bottom"
    in property <string> position: "top";
    // 对齐方式："center" | "left" | "right"
    in property <string> alignment: "center";
    // 是否启用
    in property <bool> enabled: true;

    property <bool> show-tip: false;

    hover-timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            if root.enabled && ta.has-hover && root.text != "" {
                root.show-tip = true;
            }
            self.running = false;
        }
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;

        changed has-hover => {
            if self.has-hover {
                if root.text != "" && root.enabled {
                    hover-timer.running = true;
                }
            } else {
                hover-timer.running = false;
                root.show-tip = false;
            }
        }

        @children
    }

    // 浮动提示气泡：不拦截鼠标事件
    if root.show-tip && root.text != "" : Rectangle {
        z: 100;
        background: Theme.content1;
        border-width: 1px;
        border-color: Theme.default-200;
        border-radius: Theme.radius-small;

        // 居中时气泡向左伸出 (自身宽 - 触发区宽) / 2；触发区常常只有 16px 的 ⓘ 图标，
        // 而气泡最宽 260px，于是往左伸 122px —— 靠窗口左沿的那些行整段文字被挤到窗口外
        // （用户报的「增强选中识别」）。按窗口左沿夹一次，所有 Tooltip 一起受益。
        // 只夹左沿：ⓘ 永远紧跟在左对齐的标题后面，右沿溢出构造不出来。
        property <length> wanted-x: root.alignment == "left" ? 0px : (root.alignment == "right" ? parent.width - self.width : (parent.width - self.width) / 2);
        x: Math.max(8px - ta.absolute-position.x, self.wanted-x);
        y: root.position == "bottom" ? parent.height + 6px : -self.height - 6px;

        // 宽高必须自己算：Rectangle 不会被子元素撑开，默认取父元素的尺寸，
        // 父元素只有一个图标那么宽时文字会被挤成竖着一列。
        width: Math.min(260px, tip-text.preferred-width + 20px);
        height: tip-text.preferred-height + 8px;

        tip-text := Text {
            x: 10px;
            y: 4px;
            width: parent.width - 20px;
            text: root.text;
            font-size: 12px;
            color: Theme.foreground;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}
