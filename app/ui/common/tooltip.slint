// ui.md §5.11 Tooltip。旧版 NextUI Tooltip（悬停 500ms 后出现，鼠标离开立即消失）。
// 采用候选 B（内嵌高 z 轴层），不抢鼠标事件与键盘焦点，避免 PopupWindow 的点击吞噬与闪烁。
import { Theme } from "theme.slint";

export component Tooltip {
    // 提示文本
    in property <string> text: "";
    // 显示方位："top" | "bottom"
    in property <string> position: "top";
    // 对齐方式："center" | "left" | "right"
    in property <string> alignment: "center";
    // 是否启用
    in property <bool> enabled: true;

    property <bool> show-tip: false;

    hover-timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            if root.enabled && ta.has-hover && root.text != "" {
                root.show-tip = true;
            }
            self.running = false;
        }
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;

        changed has-hover => {
            if self.has-hover {
                if root.text != "" && root.enabled {
                    hover-timer.running = true;
                }
            } else {
                hover-timer.running = false;
                root.show-tip = false;
            }
        }

        @children
    }

    // 浮动提示气泡：不拦截鼠标事件
    if root.show-tip && root.text != "" : Rectangle {
        z: 100;
        background: Theme.content1;
        border-width: 1px;
        border-color: Theme.default-200;
        border-radius: Theme.radius-small;

        x: root.alignment == "left" ? 0px : (root.alignment == "right" ? parent.width - self.width : (parent.width - self.width) / 2);
        y: root.position == "bottom" ? parent.height + 6px : -self.height - 6px;
        max-width: 260px;

        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 4px;
            padding-bottom: 4px;

            Text {
                text: root.text;
                font-size: 12px;
                color: Theme.foreground;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
    }
}
